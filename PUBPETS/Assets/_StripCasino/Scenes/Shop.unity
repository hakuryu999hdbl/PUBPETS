  J: "\u7D2B\u306E\u30E0\u30FC\u30C9\uFF08\u30D0\u30A4\u30D6\uFF09\u2192 \u5973\u30C7\u30A3\u30FC\u30E9\u30FC\u306E\u70B9\u6570\u3092\u5F37\u5236\u7684\u306B+1\u307E\u305F\u306F-1\u306B\u3059\u308B\uFF08\u30E9\u30F3\u30C0\u30E0\uFF09"
  C_1: "\u7D2B\u8272\u5FC3\u60C5\uFF08\u8DF3\u86CB\uFF09\u2192 \u5F3A\u5236\u8BA9\u5973\u8377\u5B98\u70B9\u6570+1\u6216-1\uFF08\u968F\u673A\uFF09"
