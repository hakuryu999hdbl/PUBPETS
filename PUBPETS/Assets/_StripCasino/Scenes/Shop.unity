  C_2: "\u5747\u8861\u6CD5\u6756 \u2192 \u4F7F\u4F60\u7684\u9EDE\u6578\u548C\u5973\u8377\u5B98\u76F8\u540C"
  E: "Balance Staff \u2192 Make your points the same as the female dealer's "
  K: "\uADE0\uD615\uC758 \uC9C0\uD321\uC774 \u2192 \uB2F9\uC2E0\uC758 \uC810\uC218\uB97C
    \uC5EC\uC131 \uB51C\uB7EC\uC640 \uAC19\uAC8C \uB9CC\uB4E6 "
  isTyped: 0
