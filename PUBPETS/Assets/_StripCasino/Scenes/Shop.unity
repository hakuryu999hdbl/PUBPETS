  C_2: "\u7D2B\u8272\u5FC3\u60C5\uFF08\u8DF3\u86CB\uFF09\u2192 \u5F37\u5236\u8B93\u5973\u8377\u5B98\u9EDE\u6578+1\u6216-1\uFF08\u96A8\u6A5F\uFF09  "
  E: "Purple Mood (Vibrator) \u2192 Force the female dealer's points +1 or -1 (random)  "
  K: "\uBCF4\uB77C\uC0C9 \uAE30\uBD84 (\uC9C4\uB3D9\uAE30) \u2192 \uC5EC\uC131 \uB51C\uB7EC\uC758
    \uC810\uC218\uB97C \uAC15\uC81C\uB85C +1 \uB610\uB294 -1 (\uB79C\uB364)"
  isTyped: 0
