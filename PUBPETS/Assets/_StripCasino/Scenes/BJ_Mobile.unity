--- !u!114 &1248969584
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1248969582}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u5B9D\u306E\u5730\u56F3\u306E\u65AD\u7247 \u2192 \u70B9\u6570\u304C21\u3092\u8D85\u3048\u308B\u5834\u5408\u30011\u301C3\u30DD\u30A4\u30F3\u30C8\u3092\u30E9\u30F3\u30C0\u30E0\u306B\u6E1B\u3089\u3059\uFF08\u6551\u6E08\u30A2\u30A4\u30C6\u30E0\uFF09"
  C_1: "\u85CF\u5B9D\u56FE\u6B8B\u7247 \u2192 \u82E5\u4F60\u7684\u70B9\u6570\u8D85\u8FC721\uFF0C\u53EF\u4EE5\u968F\u673A\u51CF\u53BB1~3\uFF08\u6551\u573A\u9053\u5177\uFF09"
  C_2: "\u85CF\u5BF6\u5716\u6B98\u7247 \u2192 \u82E5\u4F60\u7684\u9EDE\u6578\u8D85\u904E21\uFF0C\u53EF\u4EE5\u96A8\u6A5F\u6E1B\u53BB1~3\uFF08\u6551\u5834\u9053\u5177\uFF09"
  E: "Treasure Map Fragment \u2192 If your points exceed 21, randomly reduce 1~3
    (a bailout item)"
  K: "\uBCF4\uBB3C\uC9C0\uB3C4 \uC870\uAC01 \u2192 \uB2F9\uC2E0\uC758 \uC810\uC218\uAC00
    21\uC744 \uCD08\uACFC\uD558\uBA74 1~3\uC744 \uB79C\uB364\uC73C\uB85C \uC904\uC77C
    \uC218 \uC788\uC74C (\uAD6C\uC870 \uC544\uC774\uD15C)"
  isTyped: 0
