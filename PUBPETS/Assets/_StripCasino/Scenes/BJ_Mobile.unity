  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u304A\u3044\u304A\u3044\u3001\u30AB\u30FC\u30C9\u3088\u308A\u305D\u306E\u592A\u3082\u3082\u306B\u76EE\u304C\u884C\u3063\u3061\u307E\u3046\u3058\u3083\u306D\u3048\u304B\u2026\u2026\uFF01"
  C_1: "\u5582\u5582\uFF0C\u6211\u7684\u773C\u775B\u6839\u672C\u4E0D\u662F\u5728\u770B\u724C\uFF0C\u662F\u5728\u770B\u5979\u7684\u5927\u817F\u554A\u2026\u2026\uFF01"
  C_2: "\u5582\u5582\uFF0C\u6211\u773C\u775B\u6839\u672C\u4E0D\u662F\u5728\u770B\u724C\uFF0C\u662F\u5728\u770B\u5979\u7684\u5927\u817F\u554A\u2026\u2026\uFF01"
  E: "Hey now, how am I supposed to focus on the cards with those thighs in view\u2026?"
  K: "\uC57C\uC57C, \uCE74\uB4DC\uBCF4\uB2E4 \uD5C8\uBC85\uC9C0\uC5D0 \uB208\uC774
    \uB354 \uAC04\uB2E4\uACE0\u2026!"
  isTyped: 1
