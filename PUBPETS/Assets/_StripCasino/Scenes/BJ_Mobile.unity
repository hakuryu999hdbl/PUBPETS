  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u2026\u2026\u672C\u6C17\u3001\u3067\u3059\u306D\u3002\u899A\u609F\u306F\u3067\u304D\u3066\u3044\u308B\u3088\u3046\u3067\u3059"
  C_1: "\u2026\u2026\u662F\u8BA4\u771F\u7684\u5462\u3002\u770B\u6765\u5DF2\u7ECF\u505A\u597D\u89C9\u609F\u4E86"
  C_2: "\u2026\u2026\u662F\u8A8D\u771F\u7684\u5462\u3002\u770B\u4F86\u5DF2\u7D93\u505A\u597D\u89BA\u609F\u4E86"
  E: "\u2026You\u2019re serious. It seems you\u2019re prepared."
  K: "\u2026\u2026\uC9C4\uC2EC\uC774\uAD70\uC694. \uAC01\uC624\uB294 \uB418\uC5B4
    \uC788\uB294 \uAC83 \uAC19\uC544\uC694."
  isTyped: 1
