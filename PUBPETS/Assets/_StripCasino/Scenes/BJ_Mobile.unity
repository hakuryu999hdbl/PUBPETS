  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3082\u3063\u3068\u51FA\u3057\u306A\u3055\u3044\u3002\u3058\u3083\u306A\u3044\u3068\u6642\u9593\u306E\u7121\u99C4\u3088"
  C_1: "\u591A\u653E\u70B9\u3002\u4E0D\u7136\u5C31\u662F\u5728\u6D6A\u8D39\u6211\u7684\u65F6\u95F4"
  C_2: "\u591A\u653E\u4E00\u9EDE\u3002\u4E0D\u7136\u5C31\u662F\u5728\u6D6A\u8CBB\u6211\u7684\u6642\u9593"
  E: "Bet more. Otherwise, you\u2019re wasting my time."
  K: "\uC880 \uB354 \uAC78\uC5B4. \uC544\uB2C8\uBA74 \uB0B4 \uC2DC\uAC04 \uB0AD\uBE44\uC57C."
  isTyped: 1
