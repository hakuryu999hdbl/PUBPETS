  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u8CA0\u3051\u305F\u6642\u306E\u3053\u3068\u3082\u3001\u8003\u3048\u305F\u4E0A\u3067\u2026\u2026\u3067\u3059\u3088\u306D\uFF1F"
  C_1: "\u8FDE\u8F93\u6389\u65F6\u7684\u540E\u679C\u2026\u2026\u4E5F\u5DF2\u7ECF\u8003\u8651\u8FC7\u4E86\uFF0C\u5BF9\u5427\uFF1F"
  C_2: "\u9023\u8F38\u6389\u6642\u7684\u5F8C\u679C\u2026\u2026\u4E5F\u5DF2\u7D93\u8003\u616E\u904E\u4E86\uFF0C\u5C0D\u5427\uFF1F"
  E: "You\u2019ve thought about losing as well\u2026 haven\u2019t you?"
  K: "\uC84C\uC744 \uB54C\uC758 \uACB0\uACFC\uB3C4\u2026\u2026 \uC0DD\uAC01\uD55C
    \uAC70\uC8E0?"
  isTyped: 1
