  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u52DD\u3066\u3070\u898B\u8FD4\u308A\u3082\u5927\u304D\u3044\u2026\u2026\u305D\u3046\u3044\u3046\u5224\u65AD\u3067\u3059\u306D"
  C_1: "\u8D62\u4E86\u7684\u8BDD\uFF0C\u56DE\u62A5\u4E5F\u4F1A\u5F88\u5927\u2026\u2026\u662F\u8FD9\u6837\u7684\u5224\u65AD\u5427"
  C_2: "\u8D0F\u4E86\u7684\u8A71\uFF0C\u56DE\u5831\u4E5F\u6703\u5F88\u5927\u2026\u2026\u662F\u9019\u6A23\u7684\u5224\u65B7\u5427"
  E: "If you win, the reward will be great\u2026 that\u2019s your judgment, right?"
  K: "\uC774\uAE30\uBA74 \uBCF4\uC0C1\uB3C4 \uD06C\uB2E4\u2026\u2026 \uADF8\uB7F0
    \uD310\uB2E8\uC774\uACA0\uC8E0."
  isTyped: 1
