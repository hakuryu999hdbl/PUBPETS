  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3048\uFF5E\uFF1F\u3053\u3093\u306A\u306B\u5F31\u304B\u3063\u305F\u3063\u3051\uFF1F\u2026\u2026\u306D\u3047\u3001\u4ECA\u306E\u8CA0\u3051\u3001\u3069\u3046\u5F01\u89E3\u3059\u308B\u306E\uFF1F\u3075\u3075\u3063\u2661"
  C_1: "\u54CE\uFF5E\u4F60\u539F\u6765\u8FD9\u4E48\u83DC\u7684\u5417\uFF1F\u8BF4\u8BF4\u770B\uFF0C\u4F60\u600E\u4E48\u89E3\u91CA\u8FD9\u6B21\u8F93\uFF1F\u563F\u563F\uFF5E\u2661"
  C_2: "\u54CE\uFF5E\u4F60\u539F\u4F86\u9019\u9EBC\u83DC\u7684\u55CE\uFF1F\u9019\u6B21\u8F38\u8981\u600E\u9EBC\u89E3\u91CB\u5462\uFF1F\u563F\u563F\uFF5E\u2661"
  E: "Eh? Were you always this weak? How are you gonna explain that loss, hmm? \u2661"
  K: "\uC5B4\uB77C~? \uC6D0\uB798 \uC774\uB807\uAC8C \uC57D\uD588\uB098? \uC774\uBC88
    \uD328\uBC30, \uC5B4\uB5BB\uAC8C \uD574\uBA85\uD560 \uAC70\uC57C? \uD6C4\uD6C4\u2661"
  isTyped: 1
