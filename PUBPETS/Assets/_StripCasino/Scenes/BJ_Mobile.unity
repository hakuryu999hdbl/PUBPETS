  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u308F\u3056\u3068\u52DD\u3063\u3066\u3001\u30A2\u30BF\u30B7\u306E\u670D\u3092\u72D9\u3063\u305F\u3093\u3067\u3057\u3087\uFF1F\u2026\u2026\u3058\u3083\u3001\u6B21\u306F\u3082\u3063\u3068\u65E9\u304F\u8131\u3044\u3058\u3083\u304A\u3063\u304B\u2661"
  C_1: "\u662F\u6545\u610F\u8D62\u4E86\u60F3\u770B\u6211\u8131\u8863\u670D\u5427\uFF1F\u2026\u2026\u90A3\u4E0B\u6B21\u6211\u8131\u5F97\u66F4\u5FEB\u2661"
  C_2: "\u6545\u610F\u8D0F\u5C31\u662F\u70BA\u4E86\u770B\u6211\u812B\u8863\u670D\u5427\uFF1F\u2026\u2026\u90A3\u4E0B\u6B21\u6211\u812B\u66F4\u5FEB\u4E00\u9EDE\u2661"
  E: "You won on purpose just to strip me, didn\u2019t you? \u2026Maybe I\u2019ll
    undress faster next time\u2661"
  K: "\uC77C\uBD80\uB7EC \uC774\uAE34 \uAC70\uC9C0? \uB0B4\uAC00 \uC637 \uBC97\uB294
    \uAC70 \uBCF4\uACE0 \uC2F6\uC5B4\uC11C\u2026 \uADF8\uB7FC \uB2E4\uC74C\uC5D4
    \uB354 \uBE68\uB9AC \uBC97\uC5B4\uC904\uAE4C?\u2661"
  isTyped: 1
