--- !u!114 &1061687005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1061687003}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u307E\u305F\u8CA0\u3051\u305F\u306E\uFF1F\u3082\uFF5E\u3001\u4ECA\u65E5\u306F\u30A2\u30BF\u30B7\u306B\u30A4\u30B8\u30E1\u3089\u308C\u305F\u3044\u65E5\u306A\u3093\u3060\uFF1F\u3058\u3083\u3001\u3082\u3063\u3068\u3044\u3058\u3081\u3066\u3042\u3052\u308B\u2661"
  C_1: "\u53C8\u8F93\u4E86\uFF1F\u4F60\u4ECA\u5929\u8BE5\u4E0D\u4F1A\u662F\u60F3\u8BA9\u6211\u6B3A\u8D1F\u4F60\u5427\uFF1F\u90A3\u6211\u5C31\u66F4\u7528\u529B\u70B9\u54AF\uFF5E\u2661"
  C_2: "\u53C8\u8F38\u4E86\uFF1F\u4F60\u4ECA\u5929\u8A72\u4E0D\u6703\u662F\u60F3\u88AB\u6211\u6B3A\u8CA0\u5427\uFF1F\u90A3\u6211\u5C31\u66F4\u72E0\u4E00\u9EDE\u56C9\uFF5E\u2661"
  E: "Lost again? Are you secretly asking me to bully you today? Then I\u2019ll go
    even harder\u2661"
  K: "\uB610 \uC84C\uC5B4? \uC624\uB298 \uC77C\uBD80\uB7EC \uB098\uD55C\uD14C \uAD34\uB86D\uD798
    \uB2F9\uD558\uACE0 \uC2F6\uC740 \uAC70\uC9C0? \uADF8\uB7FC \uB354 \uAD34\uB86D\uD600\uC904\uAC8C\u2661"
  isTyped: 1
