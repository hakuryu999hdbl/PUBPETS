  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3075\u3075\u3063\u2026\u2026\u30A2\u30BF\u30B7\u3068\u3084\u308B\u304B\u3089\u306B\u306F\u305D\u308C\u306A\u308A\u306E\u899A\u609F\u3001\u3042\u308B\u3088\u306D\uFF1F"
  C_1: "\u54FC\u54FC\uFF5E\u6562\u548C\u6211\u73A9\uFF0C\u53EF\u8981\u505A\u597D\u5FC3\u7406\u51C6\u5907\u54E6\uFF1F"
  C_2: "\u54FC\u54FC\uFF5E\u6562\u8DDF\u6211\u73A9\uFF0C\u53EF\u8981\u505A\u597D\u5FC3\u7406\u6E96\u5099\u5594\uFF1F"
  E: "Fufu\u2026 if you\u2019re going to play with me, you\u2019d better be prepared."
  K: "\uD6C4\uD6C4\u2026 \uB098\uB791 \uD558\uB824\uBA74, \uADF8\uB9CC\uD55C \uAC01\uC624\uCBE4\uC740
    \uB418\uC5B4 \uC788\uACA0\uC9C0?"
  isTyped: 1
