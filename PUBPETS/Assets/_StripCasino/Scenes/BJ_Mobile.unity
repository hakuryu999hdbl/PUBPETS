  J: "\u3048\u301C\u3001\u305D\u308C\u3060\u3051\uFF1F\u4ECA\u65E5\u306F\u63A7\u3048\u3081\u3060\u306D\u301C\uFF1F"
  C_1: "\u8BF6\u301C\uFF0C\u5C31\u8FD9\u4E48\u70B9\uFF1F\u4ECA\u5929\u5F88\u4FDD\u5B88\u561B\u301C\uFF1F"
  C_2: "\u6B38\u301C\uFF0C\u53EA\u6709\u9019\u6A23\uFF1F\u4ECA\u5929\u5F88\u4FDD\u5B88\u5462\u301C\uFF1F"
  E: "Eh~ that\u2019s all? Playing it safe today~?"
  K: "\uC5B4\u301C, \uADF8\uAC8C \uB2E4\uC57C? \uC624\uB298\uC740 \uAF64 \uC870\uC2EC\uC2A4\uB7FD\uB124~?"
