  C_1: "\u54C7\uFF5E\u771F\u7684\u7A7F\u90A3\u79CD\u8863\u670D\u6765\u6253\u724C\uFF01\uFF1F\u6211\u60F3\u770B\u5979\u8131\u6389\u554A\uFF5E"
  C_2: "\u54C7\uFF5E\u771F\u7684\u7A7F\u90A3\u7A2E\u8863\u670D\u4F86\u6253\u724C\uFF01\uFF1F\u597D\u60F3\u770B\u5979\u812B\u6389\u554A\uFF5E"
  E: "Whoa, is she really playing in that outfit!? I wanna see her strip\uFF5E"
  K: "\uC640~ \uC9C4\uC9DC \uC800 \uC637 \uC785\uACE0 \uCE74\uB4DC \uCE58\uB294 \uAC70\uC57C!?
    \uBC97\uB294 \uAC70 \uBCF4\uACE0 \uC2F6\uB2E4~"
  isTyped: 1
