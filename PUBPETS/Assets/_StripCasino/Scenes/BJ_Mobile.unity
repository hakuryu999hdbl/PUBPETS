  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3079\u3001\u5225\u306B\u6094\u3057\u304F\u306A\u3093\u304B\u306A\u3044\u3057\uFF01\u2026\u2026\u3069\u3093\u306A\u3054\u8912\u7F8E\u3082\u3089\u3048\u308B\u304B\u3001\u8003\u3048\u3066\u305F\u3060\u3051\u3060\u304B\u3089\u3063\uFF01"
  C_1: "\u6211\u624D\u4E0D\u96BE\u8FC7\u5462\uFF01\u2026\u2026\u6211\u53EA\u662F\u5728\u60F3\u8BE5\u7ED9\u4F60\u4EC0\u4E48\u5956\u52B1\u7F62\u4E86\uFF01"
  C_2: "\u6211\u624D\u4E0D\u96E3\u904E\u5566\uFF01\u2026\u2026\u6211\u53EA\u662F\u60F3\u8457\u8A72\u7D66\u4F60\u4EC0\u9EBC\u734E\u52F5\u5566\uFF01"
  E: "I\u2019m not upset, okay!? \u2026I was just thinking of a good reward for you!"
  K: "\uC808, \uC808\uB300 \uC544\uC26C\uC6B4 \uAC70 \uC544\uB0D0! \u2026\uADF8\uB0E5
    \uBCF4\uC0C1 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC744 \uBFD0\uC774\uC57C!"
  isTyped: 1
