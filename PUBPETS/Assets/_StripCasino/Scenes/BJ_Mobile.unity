  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u2026\u2026\u305D\u306E\u8CED\u3051\u91D1\u3067\u3001\u52DD\u7B97\u306F\u3042\u308B\u3093\u3067\u3059\u304B\uFF1F"
  C_1: "\u2026\u2026\u7528\u8FD9\u6837\u7684\u7B79\u7801\uFF0C\u6709\u80DC\u7B97\u5417\uFF1F"
  C_2: "\u2026\u2026\u7528\u9019\u6A23\u7684\u7C4C\u78BC\uFF0C\u6709\u52DD\u7B97\u55CE\uFF1F"
  E: "\u2026With a bet like that, do you really have a chance to win?"
  K: "\u2026\u2026\uADF8 \uC815\uB3C4 \uD310\uB3C8\uC73C\uB85C, \uC774\uAE38 \uC218
    \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC694?"
  isTyped: 1
