  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3053\u306E\u30C6\u30FC\u30D6\u30EB\u3067\u52DD\u3066\u3070\u3001\u30A2\u30BF\u30B7\u306E\u5168\u90E8\u2026\u2026\u898B\u305B\u3066\u3042\u3052\u308B\u2661"
  C_1: "\u8D62\u4E86\u8FD9\u5C40\u7684\u8BDD\uFF0C\u6211\u7684\u5168\u90E8\u2026\u2026\u90FD\u7ED9\u4F60\u770B\u54E6\u2661"
  C_2: "\u8D0F\u4E86\u9019\u5C40\u7684\u8A71\uFF0C\u6211\u7684\u5168\u90E8\u2026\u2026\u90FD\u8B93\u4F60\u770B\u5537\u2661"
  E: "If you win at this table, I\u2019ll show you everything\u2026\u2661"
  K: "\uC774 \uD14C\uC774\uBE14\uC5D0\uC11C \uC774\uAE30\uBA74, \uB0B4 \uBAA8\uB4E0
