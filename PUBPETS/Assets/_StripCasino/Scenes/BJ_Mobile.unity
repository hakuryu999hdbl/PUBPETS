  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3075\u3075\uFF5E\u30A2\u30F3\u30BF\u306E\u624B\u672D\u3001\u30A2\u30BF\u30B7\u306E\u6628\u65E5\u306E\u4E0B\u7740\u3088\u308A\u5C11\u306A\u3044\u3093\u3058\u3083\u306A\u3044\uFF1F\u2661"
  C_1: "\u563F\u563F\uFF5E\u4F60\u624B\u4E0A\u7684\u724C\uFF0C\u597D\u50CF\u6BD4\u6211\u6628\u5929\u7A7F\u7684\u5185\u88E4\u8FD8\u5C11\u5462\u2661"
  C_2: "\u563F\u563F\uFF5E\u4F60\u7684\u624B\u724C\uFF0C\u6BD4\u6211\u6628\u5929\u7A7F\u7684\u5167\u8932\u9084\u5C11\u5537\u2661"
  E: "Hehe\uFF5E Your hand looks smaller than my panties last night\u2661"
  K: "\uD6C4\uD6C4~ \uB124 \uD328, \uC5B4\uC81C \uB0B4\uAC00 \uC785\uC5C8\uB358 \uD32C\uD2F0\uBCF4\uB2E4
