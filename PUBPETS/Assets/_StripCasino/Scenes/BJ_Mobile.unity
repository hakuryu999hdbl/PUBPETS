--- !u!114 &1128940933
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1128940931}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u6C17\u3092\u3064\u3051\u3066\uFF5E\u3002\u30A2\u30BF\u30B7\u306F\u30AB\u30FC\u30C9\u3060\u3051\u3058\u3083\u306A\u304F\u3063\u3066\u3001\u30C8\u30EA\u30C3\u30AF\u3082\u4F7F\u3046\u304B\u3089\u306D\u3002"
  C_1: "\u5C0F\u5FC3\u54E6\uFF0C\u6211\u4E0D\u53EA\u662F\u4F1A\u73A9\u724C\uFF0C\u8FD8\u4F1A\u73A9\u70B9\u5176\u4ED6\u7684\u5C0F\u628A\u620F\u3002"
  C_2: "\u5C0F\u5FC3\u54E6\uFF0C\u6211\u4E0D\u53EA\u662F\u6703\u73A9\u724C\uFF0C\u9084\u6703\u73A9\u9EDE\u5176\u4ED6\u7684\u5C0F\u628A\u6232\u3002"
  E: Be careful, I'm not just good at cards; I play other little tricks too.
  K: "\uC870\uC2EC\uD558\uC138\uC694, \uC800\uB294 \uCE74\uB4DC\uBFD0\uB9CC \uC544\uB2C8\uB77C
    \uB2E4\uB978 \uC791\uC740 \uC18D\uC784\uC218\uB3C4 \uC4F8 \uC904 \uC555\uB2C8\uB2E4."
  isTyped: 1
