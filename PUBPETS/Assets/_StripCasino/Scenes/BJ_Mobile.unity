  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3072\u3063\u304F\u2026\u2026\u306D\u3047\u306D\u3047\u3001\u3082\u3057\u8CA0\u3051\u305F\u3089\u3001\u819D\u306E\u4E0A\u3067\u6CE3\u3044\u3066\u304F\u308C\u3093\u306E\uFF1F"
  C_1: "\u55DD\u2026\u2026\u563F\u563F\uFF0C\u8981\u662F\u5979\u8F93\u4E86\uFF0C\u4F1A\u4E0D\u4F1A\u5750\u6211\u817F\u4E0A\u54ED\u5440\uFF1F"
  C_2: "\u55DD\u2026\u2026\u563F\u563F\uFF0C\u8981\u662F\u5979\u8F38\u4E86\uFF0C\u6703\u4E0D\u6703\u5750\u6211\u817F\u4E0A\u54ED\u5462\uFF1F"
  E: "Hic\u2026 hey hey, if she loses, will she cry on my lap?"
  K: "\uD788\uB045\u2026 \uC800\uAE30, \uC9C0\uBA74 \uB0B4 \uBB34\uB98E \uC704\uC5D0\uC11C
    \uC6B8\uC5B4\uC904\uAE4C?"
  isTyped: 1
