--- !u!114 &1639437324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1639437322}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u2026\u2026\u4ECA\u591C\u3001\u30A2\u30BF\u30B7\u3092\u304A\u6301\u3061\u5E30\u308A\u3057\u306A\u3044\uFF1F\u3058\u3083\u306A\u3044\u3068\u3001\u8AB0\u304B\u306B\u53D6\u3089\u308C\u3061\u3083\u3046\u304B\u3082\u3088\uFF1F"
  C_1: "\u2026\u2026\u4ECA\u665A\u8981\u4E0D\u8981\u5E26\u6211\u56DE\u5BB6\u5440\uFF0C\u4E0D\u7136\u6211\u53EF\u80FD\u4F1A\u88AB\u4ED6\u4EEC\u62A2\u8D70\u5462\u2026\u2026  "
  C_2: "\u2026\u2026\u4ECA\u665A\u8981\u4E0D\u8981\u5E36\u6211\u56DE\u5BB6\u5440\uFF0C\u4E0D\u7136\u6211\u53EF\u80FD\u6703\u88AB\u4ED6\u5011\u6436\u8D70\u5462\u2026\u2026  "
  E: "\u2026\u2026Why don\u2019t you take me home tonight? Otherwise, someone else
    might steal me away\u2026\u2026"
  K: "\u2026\u2026\uC624\uB298 \uBC24 \uB098\uB97C \uC9D1\uC5D0 \uB370\uB824\uAC00\uC9C0
    \uC54A\uC744\uB798? \uC548 \uADF8\uB7EC\uBA74 \uB204\uAD70\uAC00 \uB098\uB97C
    \uBE7C\uC557\uC544 \uAC08\uC9C0\uB3C4\u2026\u2026"
  isTyped: 1
