--- !u!114 &1148605286
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1148605284}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30D6\u30E9\u30C3\u30AF\u30B8\u30E3\u30C3\u30AF\u306E\u30B2\u30FC\u30E0\u624B\u9806\u3068\u30D9\u30C3\u30C6\u30A3\u30F3\u30B0\u30AA\u30D7\u30B7\u30E7\u30F3\uFF1A 
    \u521D\u671F\u914D\u5E03\uFF1A\u5404\u30D7\u30EC\u30A4\u30E4\u30FC\u3068\u30C7\u30A3\u30FC\u30E9\u30FC\u306F2\u679A\u306E\u30AB\u30FC\u30C9\u3092\u53D7\u3051\u53D6\u308A\u307E\u3059\u3002\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u30AB\u30FC\u30C9\u306F\u901A\u5E38\u8868\u5411\u304D\u306B\u914D\u3089\u308C\u3001\u30C7\u30A3\u30FC\u30E9\u30FC\u306E\u30AB\u30FC\u30C9\u306E\u4E00\u679A\u306F\u88CF\u5411\u304D\u3067\u3059\u3002
    \u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u9078\u629E\uFF1A \u30D2\u30C3\u30C8\uFF1A\u5225\u306E\u30AB\u30FC\u30C9\u3092\u8981\u6C42\u3057\u307E\u3059\u3002\u30B9\u30BF\u30F3\u30C9\u3059\u308B\u304B\u30D0\u30B9\u30C8\u3059\u308B\u307E\u3067\u4F55\u5EA6\u3067\u3082\u30D2\u30C3\u30C8\u3067\u304D\u307E\u3059\u3002
    \u30B9\u30BF\u30F3\u30C9\uFF1A\u73FE\u5728\u306E\u5408\u8A08\u3092\u4FDD\u6301\u3057\u3001\u30BF\u30FC\u30F3\u3092\u7D42\u4E86\u3057\u307E\u3059\u3002
    \u30C0\u30D6\u30EB\u30C0\u30A6\u30F3\uFF1A\u8CED\u3051\u91D1\u3092\u500D\u306B\u3057\u3066\u3001\u6B63\u78BA\u306B1\u679A\u3060\u3051\u30AB\u30FC\u30C9\u3092\u53D7\u3051\u53D6\u308A\u307E\u3059\uFF08\u6700\u521D\u306E2\u679A\u306E\u30AB\u30FC\u30C9\u306B\u306E\u307F\u5229\u7528\u53EF\u80FD\uFF09\u3002
    \u30B9\u30D7\u30EA\u30C3\u30C8\uFF1A\u540C\u3058\u30E9\u30F3\u30AF\u306E2\u679A\u306E\u30AB\u30FC\u30C9\u304C\u3042\u308B\u5834\u5408\u3001\u305D\u308C\u3089\u30922\u3064\u306E\u5225\u3005\u306E\u624B\u306B\u5206\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u3001\u8CED\u3051\u91D1\u3092\u500D\u306B\u3057\u307E\u3059\u3002\u305D\u308C\u305E\u308C\u306E\u624B\u306F\u5225\u3005\u306B\u30D7\u30EC\u30A4\u3055\u308C\u307E\u3059\u3002
    \u30A4\u30F3\u30B7\u30E5\u30E9\u30F3\u30B9\uFF1A\u30C7\u30A3\u30FC\u30E9\u30FC\u306E\u8868\u5411\u304D\u306E\u30AB\u30FC\u30C9\u304C\u30A8\u30FC\u30B9\u306E\u5834\u5408\u3001\u30A4\u30F3\u30B7\u30E5\u30E9\u30F3\u30B9\uFF08\u30C7\u30A3\u30FC\u30E9\u30FC\u304C\u30D6\u30E9\u30C3\u30AF\u30B8\u30E3\u30C3\u30AF\u3092\u6301\u3063\u3066\u3044\u308B\u304B\u306E\u8CED\u3051\uFF09\u3092\u53D6\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\u30A4\u30F3\u30B7\u30E5\u30E9\u30F3\u30B9\u306E\u8CED\u3051\u91D1\u306F\u5143\u306E\u8CED\u3051\u91D1\u306E\u534A\u5206\u3067\u3059\u3002\u30C7\u30A3\u30FC\u30E9\u30FC\u304C\u30D6\u30E9\u30C3\u30AF\u30B8\u30E3\u30C3\u30AF\u306E\u5834\u5408\u30012:1\u3067\u652F\u6255\u308F\u308C\u307E\u3059\u3002
    \u30C7\u30A3\u30FC\u30E9\u30FC\u306E\u30D7\u30EC\u30A4\uFF1A\u30C7\u30A3\u30FC\u30E9\u30FC\u306F\u96A0\u3055\u308C\u305F\u30AB\u30FC\u30C9\u3092\u660E\u304B\u3057\u3001\u30AB\u30FC\u30C9\u306E\u5408\u8A08\u304C17\u4EE5\u4E0A\u306B\u306A\u308B\u307E\u3067\u30D2\u30C3\u30C8\u3057\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\u3002
    \u652F\u6255\u3044\uFF1A \u52DD\u5229\u3057\u305F\u624B\uFF1A1:1\u3067\u652F\u6255\u3044\u307E\u3059\u3002
    \u30D6\u30E9\u30C3\u30AF\u30B8\u30E3\u30C3\u30AF\uFF08\u521D\u671F\u624B\u304C\u30A8\u30FC\u30B9\u306810\u70B9\u306E\u30AB\u30FC\u30C9\uFF09\uFF1A3:2\u3067\u652F\u6255\u3044\u307E\u3059\u3002
    \u30A4\u30F3\u30B7\u30E5\u30E9\u30F3\u30B9\uFF1A\u30C7\u30A3\u30FC\u30E9\u30FC\u304C\u30D6\u30E9\u30C3\u30AF\u30B8\u30E3\u30C3\u30AF\u306E\u5834\u5408\u30012:1\u3067\u652F\u6245\u3044\u307E\u3059\u3002"
  C_1: "\u9ED1\u6770\u514B\u6E38\u620F\u6B65\u9AA4\u548C\u6295\u6CE8\u9009\u9879\uFF1A 
    \u521D\u59CB\u53D1\u724C\uFF1A\u6BCF\u4F4D\u73A9\u5BB6\u548C\u5E84\u5BB6\u5404\u53D1\u4E24\u5F20\u724C\u3002\u73A9\u5BB6\u7684\u724C\u901A\u5E38\u9762\u671D\u4E0A\uFF1B\u5E84\u5BB6\u6709\u4E00\u5F20\u724C\u9762\u671D\u4E0B\u3002
    \u73A9\u5BB6\u51B3\u7B56\uFF1A \u8981\u724C\uFF1A\u8BF7\u6C42\u989D\u5916\u7684\u724C\u3002\u53EF\u4EE5\u8981\u724C\u76F4\u5230\u9009\u62E9\u505C\u724C\u6216\u7206\u724C\u3002
    \u505C\u724C\uFF1A\u4FDD\u6301\u5F53\u524D\u603B\u70B9\u6570\u5E76\u7ED3\u675F\u56DE\u5408\u3002
    \u52A0\u500D\uFF1A\u52A0\u500D\u4F60\u7684\u8D4C\u6CE8\uFF0C\u5E76\u53EA\u83B7\u53D6\u4E00\u5F20\u989D\u5916\u7684\u724C\uFF08\u4EC5\u9650\u9996\u4E24\u5F20\u724C\u53EF\u7528\uFF09\u3002
    \u5206\u724C\uFF1A\u5982\u679C\u4F60\u6709\u4E24\u5F20\u76F8\u540C\u70B9\u6570\u7684\u724C\uFF0C\u53EF\u4EE5\u5C06\u5B83\u4EEC\u5206\u6210\u4E24\u624B\u8FDB\u884C\uFF0C\u8D4C\u6CE8\u52A0\u500D\u3002\u6BCF\u624B\u5206\u5F00\u6253\u3002
    \u4FDD\u9669\uFF1A\u5982\u679C\u5E84\u5BB6\u9762\u671D\u4E0A\u7684\u724C\u662FA\uFF0C\u53EF\u4EE5\u8D2D\u4E70\u4FDD\u9669\uFF0C\u8FD9\u662F\u4E00\u4E2A\u8D4C\u6CE8\u5E84\u5BB6\u6709\u9ED1\u6770\u514B\u7684\u8D4C\u6CE8\u3002\u4FDD\u9669\u8D4C\u6CE8\u4E3A\u539F\u8D4C\u6CE8\u7684\u4E00\u534A\u3002\u5982\u679C\u5E84\u5BB6\u6709\u9ED1\u6770\u514B\uFF0C\u8D54\u7387\u4E3A2:1\u3002
    \u5E84\u5BB6\u884C\u52A8\uFF1A\u5E84\u5BB6\u63ED\u793A\u4ED6\u4EEC\u7684\u9690\u85CF\u724C\uFF0C\u5FC5\u987B\u6301\u7EED\u8981\u724C\u76F4\u5230\u624B\u724C\u603B\u6570\u8FBE\u523017\u70B9\u6216\u66F4\u9AD8\u3002
    \u8D54\u7387\uFF1A \u8D62\u5F97\u624B\u724C\uFF1A\u8D54\u7387\u4E3A1:1\u3002
    \u9ED1\u6770\u514B\uFF08\u9996\u53D1\u724C\u662FA\u548C10\u70B9\u724C\uFF09\uFF1A\u8D54\u7387\u4E3A3:2\u3002
    \u4FDD\u9669\uFF1A\u5982\u679C\u5E84\u5BB6\u6709\u9ED1\u6770\u514B\uFF0C\u8D54\u7387\u4E3A2:1\u3002"
  C_2: "\u9ED1\u5091\u514B\u904A\u6232\u6B65\u9A5F\u548C\u6295\u6CE8\u9078\u9805\uFF1A 
    \u521D\u59CB\u767C\u724C\uFF1A\u6BCF\u4F4D\u73A9\u5BB6\u548C\u838A\u5BB6\u5404\u767C\u5169\u5F35\u724C\u3002\u73A9\u5BB6\u7684\u724C\u901A\u5E38\u9762\u671D\u4E0A\uFF1B\u838A\u5BB6\u6709\u4E00\u5F35\u724C\u9762\u671D\u4E0B\u3002
    \u73A9\u5BB6\u6C7A\u7B56\uFF1A \u8981\u724C\uFF1A\u8ACB\u6C42\u984D\u5916\u7684\u724C\u3002\u53EF\u4EE5\u8981\u724C\u76F4\u5230\u9078\u64C7\u505C\u724C\u6216\u7206\u724C\u3002
    \u505C\u724C\uFF1A\u4FDD\u6301\u7576\u524D\u7E3D\u9EDE\u6578\u4E26\u7D50\u675F\u56DE\u5408\u3002
    \u52A0\u500D\uFF1A\u52A0\u500D\u4F60\u7684\u8CED\u6CE8\uFF0C\u4E26\u53EA\u7372\u53D6\u4E00\u5F35\u984D\u5916\u7684\u724C\uFF08\u50C5\u9650\u9996\u5169\u5F35\u724C\u53EF\u7528\uFF09\u3002
    \u5206\u724C\uFF1A\u5982\u679C\u4F60\u6709\u5169\u5F35\u76F8\u540C\u9EDE\u6578\u7684\u724C\uFF0C\u53EF\u4EE5\u5C07\u5B83\u5011\u5206\u6210\u5169\u624B\u9032\u884C\uFF0C\u8CED\u6CE8\u52A0\u500D\u3002\u6BCF\u624B\u5206\u958B\u6253\u3002
    \u4FDD\u96AA\uFF1A\u5982\u679C\u838A\u5BB6\u9762\u671D\u4E0A\u7684\u724C\u662FA\uFF0C\u53EF\u4EE5\u8CFC\u8CB7\u4FDD\u96AA\uFF0C\u9019\u662F\u4E00\u500B\u8CED\u6CE8\u838A\u5BB6\u6709\u9ED1\u5091\u514B\u7684\u8CED\u6CE8\u3002\u4FDD\u96AA\u8CED\u6CE8\u70BA\u539F\u8CED\u6CE8\u7684\u4E00\u534A\u3002\u5982\u679C\u838A\u5BB6\u6709\u9ED1\u5091\u514B\uFF0C\u8CE0\u7387\u70BA2:1\u3002
    \u838A\u5BB6\u884C\u52D5\uFF1A\u838A\u5BB6\u63ED\u793A\u4ED6\u5011\u7684\u96B1\u85CF\u724C\uFF0C\u5FC5\u9808\u6301\u7E8C\u8981\u724C\u76F4\u5230\u624B\u724C\u7E3D\u6578\u9054\u523017\u9EDE\u6216\u66F4\u9AD8\u3002
    \u8CE0\u7387\uFF1A \u8D0F\u5F97\u624B\u724C\uFF1A\u8CE0\u7387\u70BA1:1\u3002
    \u9ED1\u5091\u514B\uFF08\u9996\u767C\u724C\u662FA\u548C10\u9EDE\u724C\uFF09\uFF1A\u8CE0\u7387\u70BA3:2\u3002
    \u4FDD\u96AA\uFF1A\u5982\u679C\u838A\u5BB6\u6709\u9ED1\u5091\u514B\uFF0C\u8CE0\u7387\u70BA2:1\u3002"
  E: 'Blackjack Game Steps and Betting Options:  Initial Deal: Each player and the
    dealer receive two cards. Players'' cards are usually dealt face up; one of the
    dealer''s cards is face down. Player Decisions: Hit: Request another card. You
    can hit as many times as you want until you stand or bust. Stand: Keep your current
    total and end your turn. Double Down: Double your bet and receive exactly one
    more card (available only on your first two cards). Split: If you have two cards
    of the same rank, you can split them into two separate hands, doubling your bet.
    Each hand is played separately. Insurance: If the dealer''s face-up card is an
    Ace, you can take insurance, which is a bet that the dealer has a blackjack.
    The insurance bet is half of your original bet. It pays 2:1 if the dealer has
    blackjack. Dealer''s Play: The dealer reveals their hidden card and must hit
    until their cards total 17 or higher. Payouts: Winning hand: Pays 1:1. Blackjack
    (an Ace and a 10-value card as initial hand): Pays 3:2. Insurance: If the dealer
    has blackjack, pays 2:1.'
  K: "\uBE14\uB799\uC7AD \uAC8C\uC784 \uC808\uCC28 \uBC0F \uBCA0\uD305 \uC635\uC158: 
    \uCD08\uAE30 \uB51C : \uAC01 \uD50C\uB808\uC774\uC5B4\uC640 \uB51C\uB7EC\uB294
    \uB450 \uC7A5\uC758 \uCE74\uB4DC\uB97C \uBC1B\uC2B5\uB2C8\uB2E4. \uD50C\uB808\uC774\uC5B4\uC758
    \uCE74\uB4DC\uB294 \uBCF4\uD1B5 \uBA74\uC744 \uC704\uB85C \uD558\uACE0; \uB51C\uB7EC\uC758
    \uD55C \uC7A5\uC758 \uCE74\uB4DC\uB294 \uBA74\uC744 \uC544\uB798\uB85C \uD569\uB2C8\uB2E4.
    \uD50C\uB808\uC774\uC5B4 \uACB0\uC815: \uD788\uD2B8 : \uCD94\uAC00 \uCE74\uB4DC\uB97C
    \uC694\uCCAD\uD569\uB2C8\uB2E4. \uC2A4\uD0E0\uB4DC\uB97C \uC120\uD0DD\uD558\uAC70\uB098
    \uBC84\uC2A4\uD2B8\uB420 \uB54C\uAE4C\uC9C0 \uD788\uD2B8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC2A4\uD0E0\uB4DC : \uD604\uC7AC \uCD1D\uC561\uC744 \uC720\uC9C0\uD558\uACE0
    \uD134\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4. \uB354\uBE14 \uB2E4\uC6B4 : \uBCA0\uD305\uC744
    \uB450 \uBC30\uB85C \uD558\uACE0 \uC815\uD655\uD788 \uD55C \uC7A5\uC758 \uCE74\uB4DC\uB9CC
    \uB354 \uBC1B\uC2B5\uB2C8\uB2E4 (\uCC98\uC74C \uB450 \uCE74\uB4DC\uC5D0\uB9CC
    \uC0AC\uC6A9 \uAC00\uB2A5). \uC2A4\uD50C\uB9BF : \uAC19\uC740 \uC21C\uC704\uC758
    \uB450 \uCE74\uB4DC\uAC00 \uC788\uC73C\uBA74 \uB450 \uAC1C\uC758 \uBCC4\uB3C4
    \uC190\uC73C\uB85C \uB098\uB20C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBCA0\uD305\uC744
    \uB450 \uBC30\uB85C \uD569\uB2C8\uB2E4. \uAC01 \uC190\uC740 \uBCC4\uB3C4\uB85C
    \uD50C\uB808\uC774\uB429\uB2C8\uB2E4. \uBCF4\uD5D8 : \uB51C\uB7EC\uC758 \uC55E\uBA74
    \uCE74\uB4DC\uAC00 \uC5D0\uC774\uC2A4\uC778 \uACBD\uC6B0, \uB51C\uB7EC\uAC00
    \uBE14\uB799\uC7AD\uC744 \uAC00\uC9C0\uACE0 \uC788\uB294\uC9C0 \uBCA0\uD305\uD558\uB294
    \uBCF4\uD5D8\uC744 \uC0B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBCF4\uD5D8 \uBCA0\uD305\uC740
    \uC6D0\uB798 \uBCA0\uD305\uC758 \uC808\uBC18\uC785\uB2C8\uB2E4. \uB51C\uB7EC\uAC00
    \uBE14\uB799\uC7AD\uC778 \uACBD\uC6B0 2:1\uB85C \uC9C0\uAE09\uB429\uB2C8\uB2E4.
    \uB51C\uB7EC\uC758 \uD50C\uB808\uC774 : \uB51C\uB7EC\uB294 \uADF8\uB4E4\uC758
    \uC228\uACA8\uC9C4 \uCE74\uB4DC\uB97C \uACF5\uAC1C\uD558\uACE0, \uADF8\uB4E4\uC758
    \uCE74\uB4DC \uCD1D\uD569\uC774 17 \uC774\uC0C1\uC774 \uB420 \uB54C\uAE4C\uC9C0
    \uD788\uD2B8\uD574\uC57C \uD569\uB2C8\uB2E4. \uC9C0\uAE09\uB960 : \uC2B9\uB9AC\uD55C
    \uC190 : 1:1\uB85C \uC9C0\uAE09\uD569\uB2C8\uB2E4. \uBE14\uB799\uC7AD (\uCD08\uAE30
    \uC190\uC774 \uC5D0\uC774\uC2A4\uC640 10\uC810 \uCE74\uB4DC) : 3:2\uB85C \uC9C0\uAE09\uD569\uB2C8\uB2E4.
    \uBCF4\uD5D8 : \uB51C\uB7EC\uAC00 \uBE14\uB799\uC7AD\uC778 \uACBD\uC6B0 2:1\uB85C
    \uC9C0\uAE09\uD569\uB2C8\uB2E4. \uC774\uB7EC\uD55C \uC124\uBA85\uC740 \uAC8C\uC784\uC758
    \uBAA8\uB4E0 \uBCA0\uD305 \uC635\uC158\uACFC \uADF8\uC5D0 \uB530\uB978 \uBC30\uB2F9\uB960\uC744
    \uC790\uC138\uD788 \uC124\uBA85\uD558\uC5EC, \uB8F0\uB81B\uC5D0 \uC775\uC219\uD558\uC9C0
    \uC54A\uC740 \uD50C\uB808\uC774\uC5B4\uB3C4 \uAC8C\uC784\uC744 \uC774\uD574\uD560
    \uC218 \uC788\uB3C4\uB85D \uB3C4\uC640\uC90D\uB2C8\uB2E4."
  isTyped: 0
