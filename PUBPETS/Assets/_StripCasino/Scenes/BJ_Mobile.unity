  C_1: "\u54CE\u5440\uFF5E\u8981\u662F\u518D\u8FDE\u8F93\u4E0B\u53BB\uFF0C\u6211\u53EF\u5C31\u8981\u8131\u5149\u5149\u4E86\u2026\u2026"
  C_2: "\u54CE\u5440\uFF5E\u8981\u662F\u518D\u9023\u8F38\u4E0B\u53BB\uFF0C\u6211\u53EF\u5C31\u8981\u812B\u5149\u5149\u4E86\u2026\u2026"
  E: "Oh no\uFF5E If I keep losing like this, I\u2019ll be totally stripped\u2026"
  K: "\uC5B4\uBA38~ \uC774\uB300\uB85C \uC9C0\uBA74, \uC804\uBD80 \uBC97\uACA8\uC9C0\uACA0\uB124\u2026"
  isTyped: 1
