--- !u!114 &371460886
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 371460884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3075\u3093\u3001\u5973\u304C\u30AB\u30FC\u30C9\u3067\u52DD\u3066\u308B\u3068\u601D\u3046\u306A\u3088\uFF1F\u2026\u2026\u8131\u3050\u6E96\u5099\u3057\u3068\u304D\u306A\uFF1F"
  C_1: "\u54FC\uFF0C\u5973\u4EBA\u8FD8\u60F3\u9760\u6253\u724C\u8D62\uFF1F\u2026\u2026\u8FD8\u662F\u51C6\u5907\u597D\u8131\u8863\u670D\u5427\uFF1F"
  C_2: "\u54FC\uFF0C\u5973\u4EBA\u9084\u60F3\u9760\u6253\u724C\u8D0F\uFF1F\u2026\u2026\u9084\u662F\u6E96\u5099\u597D\u812B\u8863\u670D\u5427\uFF1F"
  E: Hmph, think a girl can win at cards? Better get ready to undress.
  K: "\uD765, \uC5EC\uC790\uAC00 \uCE74\uB4DC\uB85C \uC774\uAE38 \uC218 \uC788\uC744
    \uAC70\uB77C \uC0DD\uAC01 \uB9C8. \uC637 \uBC97\uC744 \uC900\uBE44\uB098 \uD574."
  isTyped: 1
