  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u2026\u2026\u307E\u3060\u7D42\u308F\u308A\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002\u6311\u6226\u306F\u7D9A\u3051\u3089\u308C\u307E\u3059"
  C_1: "\u2026\u2026\u8FD8\u6CA1\u7ED3\u675F\u3002\u6311\u6218\u4F9D\u7136\u53EF\u4EE5\u7EE7\u7EED"
  C_2: "\u2026\u2026\u9084\u6C92\u7D50\u675F\uFF0C\u6311\u6230\u4F9D\u7136\u53EF\u4EE5\u7E7C\u7E8C"
  E: "\u2026It\u2019s not over yet. You can still challenge again"
  K: "\u2026\u2026\uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uC5B4\uC694. \uB3C4\uC804\uC740
    \uACC4\uC18D\uD560 \uC218 \uC788\uC5B4\uC694"
  isTyped: 1
