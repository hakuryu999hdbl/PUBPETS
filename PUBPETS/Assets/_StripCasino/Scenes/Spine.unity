--- !u!114 &2024896925
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2024896923}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u9189\u72D7\u9152\u5834\u306E\u6700\u5F8C\u306E\u591C\u3001\u30A2\u30EA\u30B9\u306F\u7D14\u767D\u306E\u30A6\u30A7\u30C7\u30A3\u30F3\u30B0\u30C9\u30EC\u30B9\u3092\u3042\u306A\u305F\u306B\u7740\u305B\u305F\u3002\u5F7C\u5973\u306F\u2026\u2026\u3082\u3046\u5B8C\u5168\u306B\u3042\u306A\u305F\u306E\u3082\u306E\u3060\u3002"
  C_1: "\u5728\u9189\u72D7\u9152\u9986\u7684\u6700\u540E\u4E00\u591C\uFF0C\u7231\u4E3D\u4E1D\u4E3A\u4F60\u7A7F\u4E0A\u4E86\u7EAF\u767D\u7684\u5A5A\u7EB1\uFF0C\u5979\u2026\u2026\u5DF2\u7ECF\u5F7B\u5E95\u5C5E\u4E8E\u4F60\u4E86\u3002"
  C_2: "\u5728\u9189\u72D7\u9152\u9928\u7684\u6700\u5F8C\u4E00\u591C\uFF0C\u611B\u9E97\u7D72\u70BA\u4F60\u7A7F\u4E0A\u4E86\u7D14\u767D\u7684\u5A5A\u7D17\uFF0C\u5979\u2026\u2026\u5DF2\u7D93\u5FB9\u5E95\u5C6C\u65BC\u4F60\u4E86\u3002"
  E: "On the final night at the Drunken Dog Tavern, Alice dressed you in a pure white
    wedding gown. She\u2026 now belongs completely to you."
  K: "\uD55C\uAD6D\uC5B4 \uCDE8\uD55C \uAC1C \uC8FC\uC810\uC758 \uB9C8\uC9C0\uB9C9
    \uBC24, \uC568\uB9AC\uC2A4\uB294 \uB2F9\uC2E0\uC5D0\uAC8C \uC21C\uBC31\uC758
    \uC6E8\uB529\uB4DC\uB808\uC2A4\uB97C \uC785\uD600\uC8FC\uC5C8\uB2E4. \uADF8\uB140\uB294\u2026
    \uC774\uC81C \uC644\uC804\uD788 \uB2F9\uC2E0\uC758 \uAC83\uC774\uB2E4."
  isTyped: 1
