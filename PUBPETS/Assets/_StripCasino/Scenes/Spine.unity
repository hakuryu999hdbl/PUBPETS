--- !u!114 &1176528551
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1176528549}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30B0\u30E9\u30B9\u306F\u7A7A\u306B\u306A\u308A\u3001\u30AB\u30FC\u30C9\u30B2\u30FC\u30E0\u3082\u7D42\u308F\u3063\u305F\u3002\u3042\u306A\u305F\u306F\u3059\u3079\u3066\u3092\u624B\u306B\u5165\u308C\u305F\u3002\u3053\u308C\u304B\u3089\u3082\u30D8\u30C6\u30A3\u3068\u5171\u306B\u3001\u30AB\u30FC\u30C9\u904A\u3073\u3068\u9152\u5834\u7D4C\u55B6\u306E\u65E5\u3005\u3092\u904E\u3054\u3057\u3066\u3044\u304F\u3053\u3068\u306B\u306A\u308B\u3060\u308D\u3046\u3002"
  C_1: "\u9152\u676F\u5DF2\u7A7A\uFF0C\u724C\u5C40\u5DF2\u5C3D\u3002\u4F60\u8D62\u5F97\u4E86\u6240\u6709\uFF0C\u4ECA\u540E\u4F9D\u65E7\u53EF\u4EE5\u4E0E\u8D6B\u8482\u8FC7\u7740\u6253\u724C\u4E0E\u7ECF\u8425\u9152\u9986\u7684\u65E5\u5B50\u3002"
  C_2: "\u9152\u676F\u5DF2\u7A7A\uFF0C\u724C\u5C40\u5DF2\u76E1\u3002\u4F60\u8D0F\u5F97\u4E86\u4E00\u5207\uFF0C\u5F80\u5F8C\u4F9D\u820A\u53EF\u4EE5\u8207\u8D6B\u8482\u904E\u8457\u6253\u724C\u8207\u7D93\u71DF\u9152\u9928\u7684\u65E5\u5B50\u3002"
  E: "The glasses are empty, the game is over. You\u2019ve won everything, and from
    now on, you can continue your days playing cards and running the tavern with
    Hetty. "
  K: "\uC794\uC740 \uBE44\uC5C8\uACE0, \uCE74\uB4DC\uD310\uB3C4 \uB05D\uB0AC\uB2E4.
    \uB2F9\uC2E0\uC740 \uBAA8\uB4E0 \uAC83\uC744 \uC190\uC5D0 \uB123\uC5C8\uACE0,
    \uC55E\uC73C\uB85C\uB3C4 \uD5E4\uD2F0\uC640 \uD568\uAED8 \uCE74\uB4DC \uB180\uC774\uC640
    \uC8FC\uC810 \uC6B4\uC601\uC758 \uB098\uB0A0\uC744 \uC774\uC5B4\uAC08 \uAC83\uC774\uB2E4. "
  isTyped: 1
