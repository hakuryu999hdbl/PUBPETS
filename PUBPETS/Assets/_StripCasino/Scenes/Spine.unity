--- !u!114 &1976287596
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1976287594}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30AB\u30FC\u30C9\u30C6\u30FC\u30D6\u30EB\u306F\u3053\u308C\u304B\u3089\u3082\u7D9A\u304D\u3001\u5192\u967A\u3082\u7D42\u308F\u3089\u306A\u3044\u3002\u305F\u3060\u4ECA\u56DE\u306F\u2026\u2026\u5F7C\u5973\u306F\u3082\u3046\u3001\u3042\u306A\u305F\u3092\u8AB0\u306B\u3082\u8B72\u3089\u306A\u3044\u3002"
  C_1: "\u724C\u684C\u53EF\u4EE5\u7EE7\u7EED\uFF0C\u5192\u9669\u4E5F\u4E0D\u4F1A\u505C\u6B62\uFF0C\u53EA\u662F\u8FD9\u4E00\u6B21\u2026\u2026\u5979\u4E0D\u518D\u4F1A\u628A\u4F60\u8BA9\u7ED9\u4EFB\u4F55\u4EBA\u3002"
  C_2: "\u724C\u684C\u4ECD\u6703\u7E7C\u7E8C\uFF0C\u5192\u96AA\u4E5F\u4E0D\u6703\u505C\u6B62\uFF0C\u4F46\u9019\u4E00\u6B21\u2026\u2026\u5979\u4E0D\u6703\u518D\u628A\u4F60\u8B93\u7D66\u4EFB\u4F55\u4EBA\u3002"
  E: "The table remains, and the adventure goes on. But this time\u2026 she will
    never give you up to anyone else. "
  K: "\uCE74\uB4DC \uD14C\uC774\uBE14\uC740 \uACC4\uC18D\uB418\uACE0, \uBAA8\uD5D8\uB3C4
    \uB05D\uB098\uC9C0 \uC54A\uB294\uB2E4. \uD558\uC9C0\uB9CC \uC774\uBC88\uC5D0\uB294\u2026
    \uADF8\uB140\uB294 \uB354 \uC774\uC0C1 \uB2F9\uC2E0\uC744 \uB204\uAD6C\uC5D0\uAC8C\uB3C4
    \uB118\uAE30\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4. "
  isTyped: 1
