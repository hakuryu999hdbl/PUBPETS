  m_Text: "\u30C7\u30A3\u30FC\u30E9\u30FC\u306E\u8868\u5411\u304D\u30AB\u30FC\u30C9\u304CA\u306E\u5834\u5408\u3001\u4FDD\u967A\u3092\u9078\u629E\u3067\u304D\u307E\u3059\u3002\n\u4FDD\u967A\u91D1\u984D\uFF1A\u30D9\u30C3\u30C8\u306E\u534A\u5206\u3092\u8FFD\u52A0\u3067\u652F\u6255\u3044\n\u30FB\u30C7\u30A3\u30FC\u30E9\u30FC\u304CBJ\u306E\u5834\u5408\n\u2192
    <color=red>\u4FDD\u967A\u304C2:1\u3067\u6255\u3044\u623B\u3057\uFF08\u672C\u91D1\uFF0B\u5229\u76CA\uFF09</color>\n\u2192
    <color=red>\u30E1\u30A4\u30F3\u8CED\u3051\u306F\u8CA0\u3051\u3066\u3082\u30C8\u30FC\u30BF\u30EB0\uFF08\u640D\u306A\u3057\uFF09</color>\n\u30FBBJ\u3067\u306A\u3044\u5834\u5408\n\u2192
    <color=red>\u4FDD\u967A\u5206\u3060\u3051\u5931\u3046\uFF08-\u534A\u5206\uFF09</color>\n\u2192
    \u901A\u5E38\u306E\u52DD\u8CA0\u7D9A\u884C\n<color=red>BJ\u306B\u306A\u308B\u78BA\u7387\u306F\u7D0430.8%</color>\u3001\u3057\u306A\u3044\u78BA\u7387\u306E\u65B9\u304C\u9AD8\u3044\uFF08<color=red>\u7D0469%</color>\uFF09"
