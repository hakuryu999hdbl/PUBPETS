  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u5834\u30AF\u30EA\u30A2\u5F8C\u3010\u77ED\u5263\u3011/\u3010\u9B54\u773C\u85AC\u6C34\u3011\uFF0B\u30D2\u30C3\u30C8\uFF1A\u6B32\u3057\u3044\u724C\u3092\u81EA\u5206\u306B\u3001\u4E0D\u5229\u306A\u724C\u3092\u76F8\u624B\u306B"
  C_1: "\u6E05\u573A\u540E\u3010\u5315\u9996\u3011/\u3010\u9B54\u773C\u836F\u6C34\u3011\uFF0B\u6293\u724C\uFF1A\u60F3\u8981\u7684\u724C\u5230\u81EA\u5DF1\uFF0C\u4E0D\u5229\u7684\u724C\u5230\u5BF9\u65B9"
  C_2: "\u6E05\u5834\u5F8C\u3010\u5315\u9996\u3011/\u3010\u9B54\u773C\u85E5\u6C34\u3011\uFF0B\u6293\u724C\uFF1A\u60F3\u8981\u7684\u724C\u5230\u81EA\u5DF1\uFF0C\u4E0D\u5229\u7684\u724C\u5230\u5C0D\u65B9"
  E: "After clear + \u3010Dagger\u3011/\u3010Demon Eye Potion\u3011\uFF0BDraw\uFF1ADesired
    card to self, bad card to opponent"
  K: "\uD074\uB9AC\uC5B4 \uD6C4 \u3010\uB2E8\uAC80\u3011/\u3010\uB9C8\uC548 \uC57D\uC218\u3011\uFF0B\uB4DC\uB85C\uC6B0\uFF1A\uC6D0\uD558\uB294
    \uD328\uB294 \uC790\uC2E0\uC5D0\uAC8C, \uBD88\uB9AC\uD55C \uD328\uB294 \uC0C1\uB300\uC5D0\uAC8C"
  isTyped: 0
