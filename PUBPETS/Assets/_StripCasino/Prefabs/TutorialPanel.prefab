--- !u!114 &6142427458872254393
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8906015826789598543}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u6700\u521D\u306E2\u679A\u306E\u5408\u8A08\u304C<color=red>9\uFF5E11\u70B9</color>\u306E\u5834\u5408\u3001\u300C\u30C0\u30D6\u30EB\u300D\u30AA\u30D7\u30B7\u30E7\u30F3\u304C\u89E3\u653E\u3055\u308C\u307E\u3059\u3002
    <color=red>\u30D9\u30C3\u30C8\u30922\u500D\u306B\u3057\u30011\u679A\u3060\u3051\u8FFD\u52A0\u30AB\u30FC\u30C9\u3092\u5F15\u3044\u305F\u5F8C\u3001\u81EA\u52D5\u7684\u306B\u30B9\u30BF\u30F3\u30C9</color>\u3002 
    \u52DD\u3066\u3070<color=red>\u5831\u916C2\u500D</color>\uFF08\u30D2\u30ED\u30A4\u30F3\u306E\u8131\u8863\u52A0\u901F\uFF01\uFF09
    \u8CA0\u3051\u308C\u3070<color=red>\u640D\u59312\u500D</color>\uFF08\u7F70\u30B2\u30FC\u30E0CG\u306E\u30EA\u30B9\u30AF\u5897\uFF09\u3002
    \u9AD8\u30EA\u30B9\u30AF\u30FB\u9AD8\u30EA\u30BF\u30FC\u30F3\u306E\u6226\u7565\u3067\u3059\u3002<color=red>\u624B\u672D\u304C\u5F37\u3044\u6642\u306B\u72D9\u304A\u3046\uFF01</color>"
  C_1: "\u73A9\u5BB6\u7684\u524D2\u5F20\u724C\u603B\u70B9\u6570\u4E3A<color=red>9\uFF5E11\u70B9</color>\u65F6\uFF0C\u201C\u52A0\u500D\uFF08Double
    Down\uFF09\u201D\u9009\u9879\u89E3\u9501\u3002 <color=red>\u4E0B\u6CE8\u7FFB\u500D\uFF0C\u53EA\u52A01\u5F20\u724C\u540E\u81EA\u52A8\u505C\u724C</color>\u3002 
    \u80DC\u51FA<color=red>\u5956\u52B1\u7FFB\u500D</color>\uFF08\u5973\u4E3B\u89D2\u8131\u8863\u52A0\u901F\uFF01\uFF09
    \u8F93\u6389<color=red>\u635F\u5931\u7FFB\u500D</color>\uFF08\u60E9\u7F5ACG\u98CE\u9669\u589E\u52A0\uFF09\u3002
    \u9AD8\u98CE\u9669\u9AD8\u56DE\u62A5\u7684\u7B56\u7565\u3002<color=red>\u624B\u724C\u5F3A\u65F6\u503C\u5F97\u4E00\u8BD5\uFF01</color>"
  C_2: "\u73A9\u5BB6\u7684\u524D2\u5F35\u724C\u7E3D\u9EDE\u6578\u70BA<color=red>9\uFF5E11\u9EDE</color>\u6642\uFF0C\u201C\u52A0\u500D\uFF08Double
    Down\uFF09\u201D\u9078\u9805\u89E3\u9396\u3002 <color=red>\u4E0B\u6CE8\u7FFB\u500D\uFF0C\u53EA\u52A01\u5F35\u724C\u5F8C\u81EA\u52D5\u505C\u724C</color>\u3002 
    \u52DD\u51FA<color=red>\u734E\u52F5\u7FFB\u500D</color>\uFF08\u5973\u4E3B\u89D2\u812B\u8863\u52A0\u901F\uFF01\uFF09
    \u8F38\u6389<color=red>\u640D\u5931\u7FFB\u500D</color>\uFF08\u61F2\u7F70CG\u98A8\u96AA\u589E\u52A0\uFF09\u3002
    \u9AD8\u98A8\u96AA\u9AD8\u56DE\u5831\u7684\u7B56\u7565\u3002<color=red>\u624B\u724C\u5F37\u6642\u503C\u5F97\u4E00\u8A66\uFF01</color>"
  E: 'When the player''s initial 2 cards total <color=red>9-11 points</color>, the
    "Double Down" option unlocks. <color=red>Double your bet, draw only 1 more card,
    then auto-stand</color>.  Win: <color=red>Double rewards</color> (heroine strips
    faster!) Lose: <color=red>Double losses</color> (higher risk of penalty CG).
    High-risk, high-reward strategy. <color=red>Aim for it with strong hands!</color>'
  K: "\uD50C\uB808\uC774\uC5B4\uC758 \uCC98\uC74C 2\uC7A5 \uCE74\uB4DC \uCD1D\uC810\uC774
    <color=red>9~11\uC810</color>\uC77C \uB54C, \"\uB354\uBE14 \uB2E4\uC6B4(Double
    Down)\" \uC635\uC158\uC774 \uD574\uC81C\uB429\uB2C8\uB2E4. <color=red>\uBCA0\uD305\uC744
    2\uBC30\uB85C \uD558\uACE0, 1\uC7A5\uB9CC \uCD94\uAC00 \uCE74\uB4DC\uB97C \uBF51\uC740
    \uD6C4 \uC790\uB3D9 \uC2A4\uD0E0\uB4DC</color>.  \uC774\uAE30\uBA74 <color=red>\uBCF4\uC0C1
    2\uBC30</color> (\uD788\uB85C\uC778 \uD0C8\uC758 \uAC00\uC18D!) \uC9C0\uBA74
    <color=red>\uC190\uC2E4 2\uBC30</color> (\uBC8C\uCE59 CG \uC704\uD5D8 \uC99D\uAC00).
    \uACE0\uC704\uD5D8 \uACE0\uC218\uC775 \uC804\uB7B5. <color=red>\uAC15\uD55C \uD328\uC77C
    \uB54C \uB178\uB824\uBCF4\uC138\uC694!</color>"
  isTyped: 0
