--- !u!114 &4569213373043810602
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 794610423204356410}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30C7\u30A3\u30FC\u30E9\u30FC\u306E\u8868\u5411\u304D\u30AB\u30FC\u30C9\u304CA\u306E\u5834\u5408\u3001\u4FDD\u967A\u3092\u9078\u629E\u3067\u304D\u307E\u3059\u3002
    \u4FDD\u967A\u91D1\u984D\uFF1A\u30D9\u30C3\u30C8\u306E\u534A\u5206\u3092\u8FFD\u52A0\u3067\u652F\u6255\u3044
    \u30FB\u30C7\u30A3\u30FC\u30E9\u30FC\u304CBJ\u306E\u5834\u5408 \u2192 <color=red>\u4FDD\u967A\u304C2:1\u3067\u6255\u3044\u623B\u3057\uFF08\u672C\u91D1\uFF0B\u5229\u76CA\uFF09</color>
    \u2192 <color=red>\u30E1\u30A4\u30F3\u8CED\u3051\u306F\u8CA0\u3051\u3066\u3082\u30C8\u30FC\u30BF\u30EB0\uFF08\u640D\u306A\u3057\uFF09</color>
    \u30FBBJ\u3067\u306A\u3044\u5834\u5408 \u2192 <color=red>\u4FDD\u967A\u5206\u3060\u3051\u5931\u3046\uFF08-\u534A\u5206\uFF09</color>
    \u2192 \u901A\u5E38\u306E\u52DD\u8CA0\u7D9A\u884C <color=red>BJ\u306B\u306A\u308B\u78BA\u7387\u306F\u7D0430.8%</color>\u3001\u3057\u306A\u3044\u78BA\u7387\u306E\u65B9\u304C\u9AD8\u3044\uFF08<color=red>\u7D0469%</color>\uFF09"
  C_1: "\u8377\u5B98\u660E\u724C\u4E3AA\u65F6\uFF0C\u53EF\u9009\u62E9\u662F\u5426\u8D2D\u4E70\u4FDD\u9669\u3002
    \u4FDD\u9669\u91D1\u989D\uFF1A\u539F\u4E0B\u6CE8\u91D1\u989D\u7684\u4E00\u534A\u989D\u5916\u652F\u4ED8
    \u30FB\u82E5\u8377\u5B98\u4E3ABJ \u2192 <color=red>\u4FDD\u9669\u4EE52:1\u8D54\u4ED8\uFF08\u672C\u91D1\uFF0B\u5229\u6DA6\uFF09</color>
    \u2192 <color=red>\u4E3B\u6CE8\u867D\u8F93\u4F46\u603B\u8BA1\u6301\u5E73\uFF08\u4E0D\u4E8F\uFF09</color>
    \u30FB\u82E5\u975EBJ \u2192 <color=red>\u4EC5\u635F\u5931\u4FDD\u9669\u91D1\uFF08-\u4E00\u534A\uFF09</color>
    \u2192 \u7EE7\u7EED\u6B63\u5E38\u5BF9\u5C40 <color=red>\u8377\u5B98BJ\u6982\u7387\u7EA630.8%</color>\uFF0C\u4E0DBJ\u7684\u6982\u7387\u66F4\u9AD8\uFF08<color=red>\u7EA669%</color>\uFF09"
  C_2: "\u8377\u5B98\u660E\u724C\u70BAA\u6642\uFF0C\u53EF\u9078\u64C7\u662F\u5426\u8CFC\u8CB7\u4FDD\u96AA\u3002
    \u4FDD\u96AA\u91D1\u984D\uFF1A\u539F\u4E0B\u6CE8\u91D1\u984D\u7684\u4E00\u534A\u984D\u5916\u652F\u4ED8
    \u30FB\u82E5\u8377\u5B98\u70BABJ \u2192 <color=red>\u4FDD\u96AA\u4EE52:1\u8CE0\u4ED8\uFF08\u672C\u91D1\uFF0B\u5229\u6F64\uFF09</color>
    \u2192 <color=red>\u4E3B\u6CE8\u96D6\u8F38\u4F46\u7E3D\u8A08\u6301\u5E73\uFF08\u4E0D\u8667\uFF09</color>
    \u30FB\u82E5\u975EBJ \u2192 <color=red>\u50C5\u640D\u5931\u4FDD\u96AA\u91D1\uFF08-\u4E00\u534A\uFF09</color>
    \u2192 \u7E7C\u7E8C\u6B63\u5E38\u5C0D\u5C40 <color=red>\u8377\u5B98BJ\u6A5F\u7387\u7D0430.8%</color>\uFF0C\u4E0DBJ\u7684\u6A5F\u7387\u8F03\u9AD8\uFF08<color=red>\u7D0469%</color>\uFF09"
  E: "When the dealer's upcard is A, you can choose to take Insurance. Insurance
    bet: Half of your original bet (added) \u30FBIf dealer has Blackjack (BJ) \u2192
    <color=red>Insurance pays 2:1 (stake + profit)</color> \u2192 <color=red>Main
    bet loses but overall net 0 (break even)</color> \u30FBIf no BJ \u2192 <color=red>Only
    lose the insurance amount (-half)</color> \u2192 Main hand continues normally
    <color=red>Dealer has BJ ~30.8% of the time</color>, no BJ is more likely (<color=red>~69%</color>)"
  K: "\uB51C\uB7EC\uC758 \uC624\uD508 \uCE74\uB4DC\uAC00 A\uC77C \uB54C, \uBCF4\uD5D8(Insurance)\uC744
    \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBCF4\uD5D8 \uAE08\uC561:
    \uC6D0\uB798 \uBCA0\uD305\uC758 \uC808\uBC18\uC744 \uCD94\uAC00 \uC9C0\uBD88
    \u30FB\uB51C\uB7EC\uAC00 \uBE14\uB799\uC7AD(BJ)\uC77C \uACBD\uC6B0 \u2192 <color=red>\uBCF4\uD5D8
    2:1 \uC9C0\uAE09 (\uBCF4\uD5D8\uAE08 + \uC774\uC775)</color> \u2192 <color=red>\uBA54\uC778
    \uBCA0\uD305\uC740 \uC9C0\uC9C0\uB9CC \uC804\uCCB4\uC801\uC73C\uB85C 0 (\uC190\uD574
    \uC5C6\uC74C)</color> \u30FBBJ\uAC00 \uC544\uB2D0 \uACBD\uC6B0 \u2192 <color=red>\uBCF4\uD5D8\uAE08\uB9CC
    \uC783\uC74C (-\uC808\uBC18)</color> \u2192 \uC77C\uBC18 \uAC8C\uC784 \uACC4\uC18D
    \uC9C4\uD589 <color=red>\uB51C\uB7EC BJ \uD655\uB960 \uC57D 30.8%</color>, BJ
    \uC544\uB2CC \uD655\uB960\uC774 \uB354 \uB192\uC74C (<color=red>\uC57D 69%</color>)"
  isTyped: 0
