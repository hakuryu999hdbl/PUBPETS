--- !u!114 &8976992737143075269
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7668849844843696931}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u540C\u3058\u6570\u5B57\u306E\u30AB\u30FC\u30C9\uFF08\u4F8B\uFF1A8\uFF0B8\u3001Q\uFF0BQ\uFF09\u304C\u6765\u305F\u5834\u5408\u306B\u9078\u3079\u308B\u7279\u5225\u30EB\u30FC\u30EB\u3002
    <color=red>\u624B\u672D\u30922\u3064\u306B\u5206\u3051\u3001\u305D\u308C\u305E\u308C\u72EC\u7ACB\u3057\u3066\u30D7\u30EC\u30A4</color>\u3002 
    <color=red>\u8FFD\u52A0\u30D9\u30C3\u30C8\u3092\u652F\u6255\u3044</color>\u3001\u305D\u308C\u305E\u308C\u300C\u30D2\u30C3\u30C8\uFF0F\u30B9\u30BF\u30F3\u30C9\u300D\u3092\u9078\u3079\u307E\u3059\u3002
    2\u3064\u3068\u3082\u52DD\u3066\u3070<color=red>\u5831\u916C2\u500D</color>\uFF08\u8131\u8863\u30C1\u30E3\u30F3\u30B9\u5897\uFF01\uFF09
    \u8CA0\u3051\u308C\u3070<color=red>\u640D\u59312\u500D</color>\u3002 \u4F53\u9A13\u7248\u3067\u306F<color=red>\u4E00\u5EA6\u3060\u3051\u5206\u5272\u53EF\u80FD</color>\u3002<color=red>\u540C\u3058\u6570\u5B57\u306E\u30DA\u30A2\u304C\u5F37\u3044\u6642\u306B\u6709\u52B9</color>\uFF01"
  C_1: "\u76F8\u540C\u6570\u5B57\u7684\u724C\uFF08\u4F8B\uFF1A8+8\u3001Q+Q\uFF09\u51FA\u73B0\u65F6\uFF0C\u53EF\u9009\u7684\u7279\u522B\u89C4\u5219\u3002
    <color=red>\u5C06\u624B\u724C\u5206\u62102\u4EFD\uFF0C\u5404\u81EA\u72EC\u7ACB\u73A9</color>\u3002 
    <color=red>\u652F\u4ED8\u989D\u5916\u4E0B\u6CE8</color>\uFF0C\u5404\u81EA\u9009\u62E9\u201C\u8981\u724C/\u505C\u724C\u201D\u3002
    \u4E24\u4EFD\u90FD\u80DC<color=red>\u5956\u52B12\u500D</color>\uFF08\u8131\u8863\u673A\u4F1A\u589E\uFF01\uFF09
    \u8F93\u6389<color=red>\u635F\u59312\u500D</color>\u3002 \u4F53\u9A8C\u7248<color=red>\u4EC5\u9650\u4E00\u6B21\u5206\u5272</color>\u3002<color=red>\u76F8\u540C\u6570\u5B57\u5BF9\u5B50\u5F3A\u65F6\u6709\u6548</color>\uFF01"
  C_2: "\u76F8\u540C\u6578\u5B57\u7684\u724C\uFF08\u4F8B\uFF1A8+8\u3001Q+Q\uFF09\u51FA\u73FE\u6642\uFF0C\u53EF\u9078\u7684\u7279\u5225\u898F\u5247\u3002
    <color=red>\u5C07\u624B\u724C\u5206\u62102\u4EFD\uFF0C\u5404\u81EA\u7368\u7ACB\u73A9</color>\u3002 
    <color=red>\u652F\u4ED8\u984D\u5916\u4E0B\u6CE8</color>\uFF0C\u5404\u81EA\u9078\u64C7\u201C\u8981\u724C/\u505C\u724C\u201D\u3002
    \u5169\u4EFD\u90FD\u52DD<color=red>\u734E\u52F52\u500D</color>\uFF08\u812B\u8863\u6A5F\u6703\u589E\uFF01\uFF09
    \u8F38\u6389<color=red>\u640D\u59312\u500D</color>\u3002 \u9AD4\u9A57\u7248<color=red>\u50C5\u9650\u4E00\u6B21\u5206\u5272</color>\u3002<color=red>\u76F8\u540C\u6578\u5B57\u5C0D\u5B50\u5F37\u6642\u6709\u6548</color>\uFF01"
  E: 'Special rule when you get a pair of the same rank (e.g., 8+8, Q+Q). <color=red>Split
    your hand into 2 separate hands, played independently</color>.  <color=red>Pay
    an additional bet</color>, then Hit/Stand on each. Win both: <color=red>Double
    rewards</color> (more stripping chances!) Lose: <color=red>Double losses</color>.
    In the demo, <color=red>limited to one split per hand</color>. <color=red>Effective
    with strong pairs!</color>'
  K: "\uAC19\uC740 \uC22B\uC790\uC758 \uCE74\uB4DC(\uC608: 8+8, Q+Q)\uAC00 \uC62C
    \uB54C \uC120\uD0DD \uAC00\uB2A5\uD55C \uD2B9\uBCC4 \uADDC\uCE59. <color=red>\uD328\uB97C
    2\uAC1C\uB85C \uB098\uB204\uC5B4 \uAC01\uAC01 \uB3C5\uB9BD\uC801\uC73C\uB85C
    \uD50C\uB808\uC774</color>.  <color=red>\uCD94\uAC00 \uBCA0\uD305 \uC9C0\uBD88</color>,
    \uAC01\uAC01 \"\uD788\uD2B8/\uC2A4\uD0E0\uB4DC\" \uC120\uD0DD. \uB458 \uB2E4
    \uC774\uAE30\uBA74 <color=red>\uBCF4\uC0C1 2\uBC30</color> (\uD0C8\uC758 \uAE30\uD68C
