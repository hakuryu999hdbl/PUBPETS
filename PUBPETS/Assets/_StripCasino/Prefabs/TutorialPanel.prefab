MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8906015826789598543}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 17
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 92
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.1
  m_Text: "\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u6700\u521D\u306E2\u679A\u306E\u5408\u8A08\u304C<color=red>9\uFF5E11\u70B9</color>\u306E\u5834\u5408\u3001\u300C\u30C0\u30D6\u30EB\u300D\u30AA\u30D7\u30B7\u30E7\u30F3\u304C\u89E3\u653E\u3055\u308C\u307E\u3059\u3002\n<color=red>\u30D9\u30C3\u30C8\u30922\u500D\u306B\u3057\u30011\u679A\u3060\u3051\u8FFD\u52A0\u30AB\u30FC\u30C9\u3092\u5F15\u3044\u305F\u5F8C\u3001\u81EA\u52D5\u7684\u306B\u30B9\u30BF\u30F3\u30C9</color>\u3002\n\n\u52DD\u3066\u3070<color=red>\u5831\u916C2\u500D</color>\uFF08\u30D2\u30ED\u30A4\u30F3\u306E\u8131\u8863\u52A0\u901F\uFF01\uFF09\n\u8CA0\u3051\u308C\u3070<color=red>\u640D\u59312\u500D</color>\uFF08\u7F70\u30B2\u30FC\u30E0CG\u306E\u30EA\u30B9\u30AF\u5897\uFF09\u3002\n\u9AD8\u30EA\u30B9\u30AF\u30FB\u9AD8\u30EA\u30BF\u30FC\u30F3\u306E\u6226\u7565\u3067\u3059\u3002<color=red>\u624B\u672D\u304C\u5F37\u3044\u6642\u306B\u72D9\u304A\u3046\uFF01</color>"
