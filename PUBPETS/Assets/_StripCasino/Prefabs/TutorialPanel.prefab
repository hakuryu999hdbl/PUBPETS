--- !u!114 &646329670529415476
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3874800345193572349}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30A2\u30F3\u30D0\u30FC\uFF08Anto\uFF09\uFF1A\u6DF7\u6C8C\u30E9\u30F3\u30C0\u30E0\u578B\u30C7\u30A3\u30FC\u30E9\u30FC
    \u30A2\u30F3\u30D0\u30FC\u306E<color=red>\u53CD\u5236\u30B2\u30FC\u30B8\u306F\u4E2D\u7A0B\u5EA6</color>\u3001\u3057\u304B\u3057\u5897\u52A0\u91CF\u306F<color=red>\u5B8C\u5168\u306B\u30E9\u30F3\u30C0\u30E0</color>\u3002
    \u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u30A2\u30A4\u30C6\u30E0\u4F7F\u7528\u6642\u3001\u30A2\u30F3\u30D0\u30FC\u306F\u53CD\u5236\u305B\u305A<color=red>\u76D7\u3093\u3067\u9006\u52B9\u679C\u3067\u4F7F\u7528</color>\uFF08\u30D7\u30EC\u30A4\u30E4\u30FC+1
    \u2192 \u30C7\u30A3\u30FC\u30E9\u30FC+1\uFF09\u3002 \u3053\u308C\u306B\u3088\u308A<color=red>\u5C40\u9762\u304C\u5927\u6DF7\u4E71</color>\uFF01\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u6709\u76CA\u306A\u5834\u5408\u3082\u6709\u5BB3\u306A\u5834\u5408\u3082\u3002
    \u4F8B\uFF1A<color=red>\u30D7\u30EC\u30A4\u30E4\u30FC+5\u304C\u30C7\u30A3\u30FC\u30E9\u30FC+5\u306B\u306A\u308A\u3001\u30C7\u30A3\u30FC\u30E9\u30FC\u30D0\u30FC\u30B9\u30C8\u3067\u9006\u8EE2\u52DD\u5229</color>\u3002
    \u30A2\u30F3\u30D0\u30FC\u306F<color=red>\u5E78\u904B\u30B3\u30A4\u30F3\u30FB\u4E0D\u904B\u30B3\u30A4\u30F3</color>\u306A\u3069\u3067\u6570\u5024\u3092\u5FAE\u8ABF\u6574\u3057\u3001\u50C5\u5DEE\u3067\u52DD\u5229\u3092\u63B4\u3080\u3002 "
  C_1: "\u5B89\u6258\uFF08Anto\uFF09\uFF1A\u6DF7\u4E71\u968F\u673A\u578B\u5973\u8377\u5B98
    \u5B89\u6258\u7684<color=red>\u53CD\u5236\u69FD\u4E2D\u7B49</color>\uFF0C\u4F46\u589E\u52A0\u6570\u91CF<color=red>\u5B8C\u5168\u968F\u673A</color>\u3002
    \u73A9\u5BB6\u4F7F\u7528\u7269\u54C1\u65F6\uFF0C\u5B89\u6258\u4E0D\u53CD\u5236\u800C\u662F<color=red>\u5077\u53D6\u5E76\u9006\u5411\u4F7F\u7528</color>\uFF08\u73A9\u5BB6+1
    \u2192 \u5973\u8377\u5B98+1\uFF09\u3002 \u4ECE\u800C\u5BFC\u81F4<color=red>\u5C40\u9762\u5927\u4E71</color>\uFF01\u53EF\u80FD\u5BF9\u73A9\u5BB6\u6709\u5229\u4E5F\u53EF\u80FD\u6709\u5BB3\u3002
    \u4F8B\uFF1A<color=red>\u73A9\u5BB6+5\u53D8\u6210\u5973\u8377\u5B98+5\uFF0C\u5973\u8377\u5B98\u7206\u724C\u9006\u8F6C\u80DC</color>\u3002
    \u5B89\u6258\u4F1A\u7528<color=red>\u5E78\u8FD0\u5E01\u30FB\u5384\u8FD0\u5E01</color>\u5FAE\u8C03\u6570\u503C\uFF0C\u4EE5\u5FAE\u5F31\u4F18\u52BF\u83B7\u80DC\u3002"
  C_2: "\u5B89\u6258\uFF08Anto\uFF09\uFF1A\u6DF7\u6C8C\u96A8\u6A5F\u578B\u5973\u8377\u5B98
    \u5B89\u6258\u7684<color=red>\u53CD\u5236\u69FD\u4E2D\u7B49</color>\uFF0C\u4F46\u589E\u52A0\u6578\u91CF<color=red>\u5B8C\u5168\u96A8\u6A5F</color>\u3002
    \u73A9\u5BB6\u4F7F\u7528\u7269\u54C1\u6642\uFF0C\u5B89\u6258\u4E0D\u53CD\u5236\u800C\u662F<color=red>\u5077\u53D6\u4E26\u9006\u5411\u4F7F\u7528</color>\uFF08\u73A9\u5BB6+1
    \u2192 \u5973\u8377\u5B98+1\uFF09\u3002 \u5F9E\u800C\u5C0E\u81F4<color=red>\u5C40\u9762\u5927\u4E82</color>\uFF01\u53EF\u80FD\u5C0D\u73A9\u5BB6\u6709\u5229\u4E5F\u53EF\u80FD\u6709\u5BB3\u3002
    \u4F8B\uFF1A<color=red>\u73A9\u5BB6+5\u8B8A\u6210\u5973\u8377\u5B98+5\uFF0C\u5973\u8377\u5B98\u7206\u724C\u9006\u8F49\u52DD</color>\u3002
    \u5B89\u6258\u6703\u7528<color=red>\u5E78\u904B\u5E63\u30FB\u5384\u904B\u5E63</color>\u5FAE\u8ABF\u6578\u503C\uFF0C\u4EE5\u5FAE\u5F31\u512A\u52E2\u7372\u52DD\u3002"
  E: "Amber (Anto): Chaotic Random Dealer Amber's <color=red>counter gauge is medium</color>,
    but the increase amount is <color=red>completely random</color>. When the player
    uses an item, Amber doesn't counter but <color=red>steals and uses it in reverse</color>
    (Player +1 \u2192 Dealer +1). This causes <color=red>total chaos</color>! It
    can benefit or harm the player. Example: <color=red>Player +5 becomes Dealer
    +5, causing dealer bust for a comeback win</color>. Amber uses <color=red>Lucky
    Coin / Unlucky Coin</color> to fine-tune her score and win by a slim margin."
  K: "\uC570\uBC84 (Anto): \uD63C\uB3C8 \uB79C\uB364\uD615 \uB51C\uB7EC \uC570\uBC84\uC758
    <color=red>\uBC18\uC81C \uAC8C\uC774\uC9C0 \uC911\uAC04</color>, \uD558\uC9C0\uB9CC
    \uC99D\uAC00\uB7C9\uC740 <color=red>\uC644\uC804 \uB79C\uB364</color>. \uD50C\uB808\uC774\uC5B4\uAC00
    \uC544\uC774\uD15C \uC0AC\uC6A9 \uC2DC, \uC570\uBC84\uB294 \uBC18\uC81C\uD558\uC9C0
    \uC54A\uACE0 <color=red>\uD6D4\uCCD0 \uC5ED\uD6A8\uACFC\uB85C \uC0AC\uC6A9</color>
    (\uD50C\uB808\uC774\uC5B4 +1 \u2192 \uB51C\uB7EC +1). \uC774\uB85C \uC778\uD574
    <color=red>\uC0C1\uD669\uC774 \uB300\uD63C\uB780</color>! \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
    \uC774\uB85C\uC6B8 \uC218\uB3C4 \uD574\uB85C\uC6B8 \uC218\uB3C4. \uC608: <color=red>\uD50C\uB808\uC774\uC5B4
    +5\uAC00 \uB51C\uB7EC +5\uB85C \uBC14\uB00C\uC5B4 \uB51C\uB7EC \uBC84\uC2A4\uD2B8\uB85C
    \uC5ED\uC804\uC2B9</color>. \uC570\uBC84\uB294 <color=red>\uD589\uC6B4 \uCF54\uC778
    / \uBD88\uC6B4 \uCF54\uC778</color>\uC73C\uB85C \uC218\uCE58\uB97C \uBBF8\uC138
    \uC870\uC815\uD574 \uADFC\uC18C\uD55C \uCC28\uC774\uB85C \uC2B9\uB9AC."
  isTyped: 0
--- !u!1 &3938287479253832348
