--- !u!114 &1425285138702636006
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5660186496883983069}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30A2\u30EA\u30B9\uFF08Alice\uFF09\uFF1A\u9632\u5FA1\u53CD\u6483\u578B\u30C7\u30A3\u30FC\u30E9\u30FC
    \u30A2\u30EA\u30B9\u306E<color=red>\u53CD\u5236\u30B2\u30FC\u30B8\u306E\u30CF\u30FC\u30C8\u306F\u4ED6\u306E\u30C7\u30A3\u30FC\u30E9\u30FC\u3088\u308A\u591A\u3044</color>\u3001\u3057\u304B\u3057<color=red>\u56DE\u5FA9\u901F\u5EA6\u306F\u9045\u3044</color>\u3002
    \u30A2\u30EA\u30B9\u306F<color=red>\u56DE\u5FA9\u7CFB\u30A2\u30A4\u30C6\u30E0\u3057\u304B\u4F7F\u308F\u305A</color>\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u30A2\u30A4\u30C6\u30E0\u4F7F\u7528\u3084\u30B9\u30BF\u30F3\u30C9\u6642\u306B<color=red>\u7E70\u308A\u8FD4\u3057\u56DE\u5FA9</color>\u3092\u884C\u3046\u3002
    \u30A2\u30EA\u30B9\u306F<color=red>\u305A\u3063\u3068\u8CA0\u3051\u7D9A\u3051\u308B\u53EF\u80FD\u6027\u304C\u9AD8\u3044</color>\u304C\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306F<color=red>\u6C7A\u3057\u3066\u5012\u305B\u305A</color>\u3001\u5F90\u3005\u306B<color=red>\u8CED\u3051\u306E\u6CBC\u306B\u5F15\u304D\u305A\u308A\u8FBC\u307E\u308C\u3001\u91D1\u8CA8\u3092\u3086\u3063\u304F\u308A\u67AF\u6E07\u3055\u305B\u308B</color>\u3002"
  C_1: "\u7231\u4E3D\u4E1D\uFF08Alice\uFF09\uFF1A\u9632\u5B88\u53CD\u51FB\u578B\u5973\u8377\u5B98
    \u7231\u4E3D\u4E1D\u7684<color=red>\u5B89\u5FC3\u53CD\u5236\u69FD\u7231\u5FC3\u6BD4\u5176\u4ED6\u5973\u8377\u5B98\u591A</color>\uFF0C\u4F46<color=red>\u6062\u590D\u901F\u5EA6\u6162</color>\u3002
    \u7231\u4E3D\u4E1D<color=red>\u53EA\u4F7F\u7528\u56DE\u8840\u9053\u5177</color>\uFF0C\u73A9\u5BB6\u4F7F\u7528\u9053\u5177\u6216\u505C\u724C\u65F6\u4F1A<color=red>\u53CD\u590D\u56DE\u8840</color>\u3002
    \u7231\u4E3D\u4E1D<color=red>\u53EF\u80FD\u4E00\u76F4\u8F93</color>\uFF0C\u4F46\u73A9\u5BB6<color=red>\u59CB\u7EC8\u65E0\u6CD5\u51FB\u8D25\u5979</color>\uFF0C\u53EA\u4F1A\u9010\u6E10\u88AB<color=red>\u62D6\u5165\u8D4C\u5C40\u6CBC\u6CFD\uFF0C\u6162\u6162\u8017\u5E72\u91D1\u5E01</color>\u3002 "
  C_2: "\u611B\u9E97\u7D72\uFF08Alice\uFF09\uFF1A\u9632\u5B88\u53CD\u64CA\u578B\u5973\u8377\u5B98
    \u611B\u9E97\u7D72\u7684<color=red>\u5B89\u5FC3\u53CD\u5236\u69FD\u611B\u5FC3\u6BD4\u5176\u4ED6\u5973\u8377\u5B98\u591A</color>\uFF0C\u4F46<color=red>\u6062\u5FA9\u901F\u5EA6\u6162</color>\u3002
    \u611B\u9E97\u7D72<color=red>\u53EA\u4F7F\u7528\u56DE\u8840\u9053\u5177</color>\uFF0C\u73A9\u5BB6\u4F7F\u7528\u9053\u5177\u6216\u505C\u724C\u6642\u6703<color=red>\u53CD\u8986\u56DE\u8840</color>\u3002
    \u611B\u9E97\u7D72<color=red>\u53EF\u80FD\u4E00\u76F4\u8F38</color>\uFF0C\u4F46\u73A9\u5BB6<color=red>\u59CB\u7D42\u7121\u6CD5\u64CA\u6557\u5979</color>\uFF0C\u53EA\u6703\u9010\u6F38\u88AB<color=red>\u62D6\u5165\u8CED\u5C40\u6CBC\u6FA4\uFF0C\u6162\u6162\u8017\u4E7E\u91D1\u5E63</color>\u3002 "
  E: 'Alice: Defensive Counter-Attack Dealer Alice has <color=red>more hearts in
    her safe counter gauge than other dealers</color>, but <color=red>recovery is
    slow</color>. Alice <color=red>only uses healing items</color>, repeatedly healing
    when the player uses items or stands. Alice <color=red>may keep losing</color>,
    but the player <color=red>can never truly defeat her</color>, slowly getting
    <color=red>dragged into the gambling swamp and drained of gold coins</color>.'
  K: "\uC568\uB9AC\uC2A4 (Alice): \uBC29\uC5B4 \uBC18\uACA9\uD615 \uB51C\uB7EC \uC568\uB9AC\uC2A4\uC758
    <color=red>\uC548\uC2EC \uBC18\uC81C \uAC8C\uC774\uC9C0 \uD558\uD2B8\uAC00 \uB2E4\uB978
    \uB51C\uB7EC\uBCF4\uB2E4 \uB9CE\uC74C</color>, \uD558\uC9C0\uB9CC <color=red>\uD68C\uBCF5
    \uC18D\uB3C4\uB294 \uB290\uB9BC</color>. \uC568\uB9AC\uC2A4\uB294 <color=red>\uD68C\uBCF5
    \uC544\uC774\uD15C\uB9CC \uC0AC\uC6A9</color>, \uD50C\uB808\uC774\uC5B4\uAC00
    \uC544\uC774\uD15C \uC0AC\uC6A9\uC774\uB098 \uC2A4\uD0E0\uB4DC \uC2DC <color=red>\uBC18\uBCF5
    \uD68C\uBCF5</color>.\uC568\uB9AC\uC2A4\uB294 <color=red>\uACC4\uC18D \uC9C8
    \uAC00\uB2A5\uC131\uC774 \uB192\uC74C</color>\uC774\uC9C0\uB9CC, \uD50C\uB808\uC774\uC5B4\uB294
    <color=red>\uC808\uB300 \uC4F0\uB7EC\uB728\uB9B4 \uC218 \uC5C6\uACE0</color>,
    \uC810\uC810 <color=red>\uB3C4\uBC15\uC758 \uB2AA\uC5D0 \uB04C\uB824\uB4E4\uC5B4\uAC00
    \uAE08\uD654\uB97C \uC11C\uC11C\uD788 \uACE0\uAC08</color>."
  isTyped: 0
