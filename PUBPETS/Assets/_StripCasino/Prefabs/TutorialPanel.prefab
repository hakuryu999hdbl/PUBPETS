--- !u!114 &7321535566793411118
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7632389364918415491}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc3d6029411081445a7812583cca3863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30D8\u30C7\u30A3\u30FC\uFF08Hetty\uFF09\uFF1A\u7A4D\u6975\u653B\u6483\u578B\u30C7\u30A3\u30FC\u30E9\u30FC
    \u30D8\u30C7\u30A3\u30FC\u306E<color=red>\u53CD\u5236\u30B2\u30FC\u30B8\u306E\u30CF\u30FC\u30C8\u306F\u5C11\u306A\u3044</color>\u3001\u3057\u304B\u3057<color=red>\u56DE\u5FA9\u304C\u975E\u5E38\u306B\u983B\u7E41</color>\u3002
    \u30D8\u30C7\u30A3\u30FC\u306F<color=red>\u5B9D\u306E\u5730\u56F3\u306E\u6B20\u7247\u30FB\u5747\u8861\u306E\u5929\u79E4</color>\u306A\u3069\u3067\u70B9\u6570\u3092\u30B3\u30F3\u30C8\u30ED\u30FC\u30EB\u3057\u3001\u6BCE\u5C40\u52DD\u5229\u3092\u72D9\u3046\u3002
    \u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u5360\u535C\u7CFB\u30A2\u30A4\u30C6\u30E0\u4F7F\u7528\uFF0B\u30D2\u30C3\u30C8\u6642\u3001<color=red>\u77ED\u5263\u306A\u3069\u3067\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u30AB\u30FC\u30C9\u3092\u7F6E\u304D\u63DB\u3048</color>\u3002
    \u5927\u30D9\u30C3\u30C8\u5BFE\u6C7A\u6642\u3001<color=red>\u30D8\u30C7\u30A3\u30FC\u306E\u30A2\u30A4\u30C6\u30E0\u4F7F\u7528\u3092\u8A98\u767A\u3057\u3084\u3059\u304F\u3001\u6700\u826F\u3067\u3082\u5F37\u5236\u5F15\u304D\u5206\u3051</color>\u3002"
  C_1: "\u8D6B\u8482\uFF08Hetty\uFF09\uFF1A\u4E3B\u52A8\u8FDB\u653B\u578B\u5973\u8377\u5B98
    \u8D6B\u8482\u7684<color=red>\u53CD\u5236\u69FD\u7231\u5FC3\u4E0D\u591A</color>\uFF0C\u4F46<color=red>\u6062\u590D\u975E\u5E38\u9891\u7E41</color>\u3002
    \u8D6B\u8482\u4F1A\u7528<color=red>\u85CF\u5B9D\u56FE\u6B8B\u7247\u30FB\u5747\u8861\u5929\u5E73</color>\u7B49\u63A7\u5236\u70B9\u6570\u9053\u5177\uFF0C\u786E\u4FDD\u6BCF\u5C40\u83B7\u80DC\u3002
    \u73A9\u5BB6\u4F7F\u7528\u5360\u535C\u7C7B\u9053\u5177+\u8981\u724C\u65F6\uFF0C<color=red>\u8D6B\u8482\u7528\u5315\u9996\u7B49\u66FF\u6362\u73A9\u5BB6\u724C</color>\u3002
    \u5927\u6CE8\u5BF9\u51B3\u65F6\uFF0C<color=red>\u5BB9\u6613\u89E6\u53D1\u8D6B\u8482\u7528\u9053\u5177\uFF0C\u6700\u597D\u60C5\u51B5\u4E5F\u5F3A\u5236\u5E73\u5C40</color>\u3002"
  C_2: "\u8D6B\u8482\uFF08Hetty\uFF09\uFF1A\u4E3B\u52D5\u9032\u653B\u578B\u5973\u8377\u5B98
    \u8D6B\u8482\u7684<color=red>\u53CD\u5236\u69FD\u611B\u5FC3\u4E0D\u591A</color>\uFF0C\u4F46<color=red>\u6062\u5FA9\u975E\u5E38\u983B\u7E41</color>\u3002
    \u8D6B\u8482\u6703\u7528<color=red>\u85CF\u5BF6\u5716\u6B98\u7247\u30FB\u5747\u8861\u5929\u5E73</color>\u7B49\u63A7\u5236\u9EDE\u6578\u9053\u5177\uFF0C\u78BA\u4FDD\u6BCF\u5C40\u7372\u52DD\u3002
    \u73A9\u5BB6\u4F7F\u7528\u5360\u535C\u985E\u9053\u5177+\u8981\u724C\u6642\uFF0C<color=red>\u8D6B\u8482\u7528\u5315\u9996\u7B49\u66FF\u63DB\u73A9\u5BB6\u724C</color>\u3002
    \u5927\u6CE8\u5C0D\u6C7A\u6642\uFF0C<color=red>\u5BB9\u6613\u89F8\u767C\u8D6B\u8482\u7528\u9053\u5177\uFF0C\u6700\u597D\u60C5\u6CC1\u4E5F\u5F37\u5236\u5E73\u5C40</color>\u3002"
  E: 'Hetty: Aggressive Offensive Dealer Hedy''s <color=red> counter gauge has few
    hearts</color>, but <color=red>recovers very frequently</color>. Hedy uses <color=red>Treasure
    Map Fragment / Balance Scale</color> to control points and win every round. When
    player uses divination items + Hit, <color=red>Hedy replaces player''s cards
    with dagger etc.</color>. Big bet showdowns <color=red>easily trigger her items,
    best case forced draw</color>.'
  K: "\uD5E4\uB514 (Hetty): \uC801\uADF9 \uACF5\uACA9\uD615 \uB51C\uB7EC \uD5E4\uB514\uC758
    <color=red> \uBC18\uC81C \uAC8C\uC774\uC9C0 \uD558\uD2B8 \uC801\uC74C</color>,
    \uD558\uC9C0\uB9CC <color=red>\uD68C\uBCF5 \uB9E4\uC6B0 \uBE48\uBC88</color>.
    \uD5E4\uB514\uB294 <color=red>\uBCF4\uBB3C \uC9C0\uB3C4 \uC870\uAC01 / \uADE0\uD615
    \uCC9C\uD3C9</color> \uB4F1\uC73C\uB85C \uC810\uC218 \uC870\uC808\uD574 \uB9E4
    \uD310 \uC2B9\uB9AC. \uD50C\uB808\uC774\uC5B4 \uC810\uC220 \uC544\uC774\uD15C
    \uC0AC\uC6A9 + \uD788\uD2B8 \uC2DC, <color=red>\uD5E4\uB514\uAC00 \uB2E8\uAC80
    \uB4F1\uC73C\uB85C \uD50C\uB808\uC774\uC5B4 \uCE74\uB4DC \uAD50\uCCB4</color>.
    \uB300 \uBCA0\uD305 \uB300\uACB0 \uC2DC, <color=red>\uD5E4\uB514 \uC544\uC774\uD15C
    \uC720\uBC1C \uC26C\uC6C0, \uCD5C\uC120\uB3C4 \uAC15\uC81C \uBB34\uC2B9\uBD80</color>."
  isTyped: 0
